# =====================================================================
# WeKnora environment variable configuration example
# ---------------------------------------------------------------------
# Usage:
#   1. Copy this file to .env: cp .env.example .env
#   2. Replace all placeholders with actual values (especially items marked ⚠️ Required)
#   3. Ensure .env is not committed to version control
#
# Configuration injection:
#   - The app service reads all variables in this file through env_file: .env;
#   - The docreader / mcp / frontend / odl-hybrid services have no env_file and only consume
#     variables explicitly listed in their respective environment sections (see docker-compose.yml).
#
# Section order:
#   A. Deployment basics       Images, runtime, networking
#   B. Data and storage        Database, Redis, file storage, object storage
#   C. Retrieval and graphs    Vector databases, knowledge graphs
#   D. Models                  LLM/VLM/Ollama, built-in models
#   E. Document parsing        Docreader, task timeouts
#   F. Authentication and tenant isolation  JWT/AES, registration, RBAC, OIDC
#   G. Agents and sandboxes    Sandbox, Skills, agent timeouts
#   H. Optional integrations   Web search, MCP Server
#   I. Observability           Langfuse
#   J. Security and tuning     SSRF, proxies, concurrency
# =====================================================================


# #####################################################################
# A. Deployment basics
# #####################################################################

# ========== A1. Image versions and builds ==========
# WeKnora image version tag: latest (stable) / main (latest development version). To upgrade to a fixed version, enter the target release's git tag (e.g. v0.7.0, including the v prefix), then run docker compose pull to fetch the corresponding images.
WEKNORA_VERSION=latest
# Debian APT mirror hostname (used to build the app image; leave empty for the default source; in China, use mirrors.tencent.com for faster downloads).
APK_MIRROR_ARG=mirrors.tencent.com
# Whether to link the anydoc in-process parsing engine when building the app image (default 1). Set to 0 to skip the Rust toolchain and shorten build time; the engine will appear as unavailable on the settings page.
# WITH_ANYDOC=1
# apt mirror for docreader image builds (leave empty for the default source).
# APT_MIRROR=
# Playwright browser artifact source for docreader image builds (leave empty for the official CDN).
# PLAYWRIGHT_DOWNLOAD_HOST=
# Overrides only the WebKit artifact source; takes precedence over PLAYWRIGHT_DOWNLOAD_HOST when set.
# PLAYWRIGHT_WEBKIT_DOWNLOAD_HOST=
# Short commit shown on the system information page when building the frontend image from source. make docker-build-frontend
# and start_all.sh --no-pull populate it automatically from git; export it yourself for direct docker compose build, otherwise it displays unknown.
# VITE_FRONTEND_COMMIT=
# npm registry for frontend image builds (leave empty for the default source; in China, use https://registry.npmmirror.com).
# NPM_REGISTRY=
# Node heap limit for Vite builds (MB). Reduce to 2048 if Docker Desktop has little memory allocated.
# NODE_MAX_OLD_SPACE_SIZE=4096

# ========== A2. Runtime basics ==========
# gin mode: debug (development, detailed logs + Swagger) / release (production, Swagger disabled).
GIN_MODE=release
# Log level: debug / info / warn / error / fatal; default debug.
# LOG_LEVEL=debug
# Log file path (leave empty for stdout only); when LLM_DEBUG_LOG is enabled, llm_debug.log is written in the same directory.
# LOG_PATH=
# Custom log format template (leave empty for the built-in default format).
# LOG_FORMAT=
# LLM debug logging: writes the full request/response of each large language model call to a separate file for troubleshooting context issues.
# Options: true (write llm_debug.log alongside LOG_PATH) / false/empty (disabled) / a specific file path.
# LLM_DEBUG_LOG=true
# Time zone, default Asia/Shanghai. Affects system time display and log timestamps.
# Common values: Asia/Shanghai, Asia/Tokyo, America/New_York, Europe/London, UTC.
TZ=Asia/Shanghai
# System default language (BCP-47), used as the fallback for the {{language}} placeholder in prompts.
# Priority: Accept-Language request header > this variable > built-in default (en-US).
WEKNORA_LANGUAGE=ko-KR
# Default frontend UI language (BCP-47). Options: zh-CN | zh-TW | en-US | ru-RU | ko-KR | ja-JP.
# Priority: user's selected language (localStorage) > this variable > built-in default zh-CN.
# Only affects first-time visitors/users who have not manually switched languages; restart the frontend container after changing it, with no image rebuild required.
DEFAULT_LOCALE=ko-KR
# Default language fallback when building the frontend image (only applies when Docker runtime config.js is not used).
# VITE_DEFAULT_LOCALE=en-US
# Automatically run database migrations on startup; set false to disable (enabled by default).
AUTO_MIGRATE=true
# Automatically recover dirty migration state (default true).
AUTO_RECOVER_DIRTY=true
# Automatically promote the user with the specified email to system administrator on startup (idempotent; only PROMOTE, never DEMOTE).
# Intended for initial docker-compose/k8s bootstrapping; subsequent privilege grants/revocations use the SystemAdmin management page.
# WEKNORA_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=

# ========== A3. Networking and external addresses ==========
# Application service hostname, default app (Docker internal service name); use the remote address for a remote backend.
APP_HOST=app
# Application service host-mapped port, default 8080 (only affects host access, not inter-container communication).
APP_PORT=8080
# Target port for NGINX to proxy to the backend, default 8080 (internal listening port of the App container).
# Keep the default for local deployments; for remote deployments, use the actual port of the remote App service.
# APP_BACKEND_PORT=8080
# Protocol for NGINX to proxy to the backend, default http; set https if the remote backend uses HTTPS.
# APP_SCHEME=http
# Frontend service port, default 80.
FRONTEND_PORT=80
# Docreader address (used by app to connect to docreader).
DOCREADER_ADDR=docreader:50051
# Docreader transport: grpc / http / https.
DOCREADER_TRANSPORT=grpc
# External application URL (affects external image/file links in IM channels).
# Set to the WeKnora instance URL reachable over the public internet by IM platforms/clients, e.g. https://weknora.example.com.
# To display knowledge base images in IM, the IM client must be able to fetch them via a public http URL; choose one:
#   (A) The storage backend itself is publicly reachable (use a public endpoint for object storage, or set MINIO_ENDPOINT to a public host);
#      resource:// then falls back to the backend's presigned URL, without needing this variable.
#   (B) Set this variable to rewrite resource:// images to <APP_EXTERNAL_URL>/r/<token> via WeKnora (nginx must proxy /r/).
# For the default MinIO deployment (minio:9000 is internal), (B) is simplest; the local backend supports only (B).
# Private IPs and localhost are unreachable by IM platforms such as Feishu/WeCom/Slack; use ngrok/cloudflared/frp for local development.
# APP_EXTERNAL_URL=
# External frontend origin, used for absolute URLs such as invitation links (leave empty for host-relative URLs).
# FRONTEND_BASE_URL=
# Default form of file references in API responses: handle (default) / public.
#   handle — Returns an internal resource://<handle>; the client must call the authenticated /files proxy to fetch the image.
#   public — Returns a directly loadable http(s) link that third-party Apps can render without a second request.
# Override this variable for a single request with ?resource_urls=handle|public; see the README's “API Reference” for the override scope.
# public requires APP_EXTERNAL_URL above (or a publicly reachable storage backend) to generate external links;
# if a link cannot be generated, the reference remains resource:// unchanged, and clients can still fall back to /files.
# Note: public issues time-limited anonymously readable links for each referenced file (WeKnora: 2 hours / MinIO: 24 hours).
# Anonymous embed channels and knowledge-base-scoped API Keys are unaffected by this variable and always return handle.
# Also configure SYSTEM_AES_KEY to reuse grant rows, stabilize direct-link URLs, and reduce writes from read endpoints.
# RESOURCE_URL_MODE=handle
# Exposed MCP Server port (default 8082).
# MCP_PORT=8082


# #####################################################################
# B. Data and storage
# #####################################################################

# ========== B1. Database ⚠️ Required ==========
# Primary database type: postgres / sqlite. sqlite is for Lite mode; see DB_PATH.
DB_DRIVER=postgres
# Database host address.
DB_HOST=postgres
# Database port.
DB_PORT=5432
# Database username.
DB_USER=postgres
# Database password.
DB_PASSWORD=postgres123!@#
# Database name.
DB_NAME=WeKnora
# Used with the SQLite driver (DB_DRIVER=sqlite); ignored by the postgres driver.
# DB_PATH=./data/weknora.db

# ========== B2. Redis / stream processing / Asynq queues ==========
# --- Stream processing backend and Redis connection ---
# Stream processing backend: memory / redis. In redis mode, the Asynq task queue also depends on this Redis instance.
STREAM_MANAGER_TYPE=redis
# Redis address (leave empty to disable Redis; use memory in Lite mode).
REDIS_ADDR=redis:6379
# Redis username (Redis 6.0+ ACL, optional).
# REDIS_USERNAME=
# Redis password; leave empty if none is configured.
REDIS_PASSWORD=redis123!@#
# Redis database index, default 0.
REDIS_DB=0
# Redis key prefix for namespace isolation.
REDIS_PREFIX=stream:
# Redis channel namespace suffix (for isolation when multiple deployments share the same Redis).
# WEKNORA_REDIS_NAMESPACE=
# Asynq client Redis read/write timeout (milliseconds, default 500; write timeout can be increased to 1000).
# WEKNORA_REDIS_OP_TIMEOUT_MS=500

# --- Redis TLS (encrypted transport for managed Redis, e.g. AWS ElastiCache; disabled by default) ---
# Whether to enable TLS.
# REDIS_USE_TLS=false
# Server name for TLS certificate verification and SNI (useful when the address is an IP).
# REDIS_TLS_SERVER_NAME=
# Skip server certificate verification. Unsafe; only for development/self-signed certificates, never for production.
# REDIS_TLS_INSECURE_SKIP_VERIFY=false

# --- Asynq worker concurrency ---
# Each pool is a separate asynq.Server with hard isolation; empty or <1 uses the code default. Values specify minimum concurrency per instance; replicas add their concurrency together. Also adjustable at runtime in system settings (asynq.*_concurrency), without restarting. Format: variable = default — consumed queues / description
# default + chat_attachment (main document parsing pipeline; chat_attachment has higher weight to avoid being crowded out by bulk imports)
# WEKNORA_ASYNQ_CORE_CONCURRENCY=8
# postprocess (post-parsing knowledge base postprocessing/fan-out; a separate pool avoids waiting behind slow DocReader jobs and provides low latency)
# WEKNORA_ASYNQ_POSTPROCESS_CONCURRENCY=2
# summary / multimodal / graph / question (summaries, multimodal images, graph chunk extraction, question generation; LLM/VLM-heavy, tune to provider budgets)
# WEKNORA_ASYNQ_ENRICHMENT_CONCURRENCY=12
# sync + low (data source sync, FAQ imports, KB cloning/deletion, bulk reparsing, knowledge moves; long-running, not eligible for borrowing by shared)
# WEKNORA_ASYNQ_MAINTENANCE_CONCURRENCY=4
# Elastic pool that can borrow CORE/ENRICHMENT queues (safe atomic dequeue); does not consume POSTPROCESS/MAINTENANCE
# WEKNORA_ASYNQ_SHARED_CONCURRENCY=6
# Dedicated Wiki generation pool (LLM-bound, tune to the provider's concurrency budget)
# WEKNORA_WIKI_ASYNQ_CONCURRENCY=8
# Per-model concurrency limit for background jobs (0/negative disables it; interactive chat is unaffected)
# WEKNORA_MODEL_MAX_CONCURRENCY=32

# ========== B3. File storage (general) ==========
# File storage type: local / minio / cos / tos / s3 / obs / oss / dummy.
STORAGE_TYPE=local
# Allowlist of storage types available to users (comma-separated; leave empty to allow all).
# STORAGE_ALLOW_LIST=local,minio,cos,tos,s3,obs,oss
# Local storage root directory (used when STORAGE_TYPE=local).
LOCAL_STORAGE_BASE_DIR=/data/files
# Local storage path prefix (for legacy backfilling; usually leave empty).
# LOCAL_STORAGE_PATH_PREFIX=
# Unified file size limit (MB, default 50). Affects single-file uploads for knowledge bases/attachments, docreader gRPC messages, and browser knowledge base validation. Deployment-time setting: Go/Nginx/docreader/browser each read it once at startup; runtime changes have no effect, so restart all four layers together after changing it.
# MAX_FILE_SIZE_MB=50
# Size limit for skill zip uploads and GitHub/ClawHub source downloads (MB, default 256). Separate from knowledge base uploads: skill bundles such as ppt-master can exceed 50MB. GitHub zipballs count the entire repository archive, not the SKILL.md subtree; oversized repositories are still rejected during download. When unset, the limit is at least MAX_FILE_SIZE_MB and at most 512. Nginx increases the limit to this value only for POST /api/v1/skills/catalog and POST /api/v1/sandbox-configs/{id}/skills; subpaths such as /install and PATCH requests still use MAX_FILE_SIZE_MB. Restart app and frontend after changing it.
# MAX_SKILL_BUNDLE_SIZE_MB=256

# ========== B4. Object storage providers (choose one based on STORAGE_TYPE) ==========
# ----- MinIO (STORAGE_TYPE=minio) -----
# MinIO endpoint (host:port). For IM channels, the host must be publicly reachable by the IM platform (do not use minio:9000).
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY_ID=your_minio_access_key
# MINIO_SECRET_ACCESS_KEY=your_minio_secret_key
# MINIO_BUCKET_NAME=your_minio_bucket_name
# MINIO_PATH_PREFIX=
# MINIO_USE_SSL=false
# MinIO port (for compose mapping).
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# ----- Tencent Cloud COS (STORAGE_TYPE=cos) -----
# COS_SECRET_ID=your_cos_secret_id
# COS_SECRET_KEY=your_cos_secret_key
# COS_REGION=ap-guangzhou
# COS_BUCKET_NAME=your_cos_bucket_name
# COS_APP_ID=your_cos_app_id
# COS_PATH_PREFIX=your_cos_path_prefix
# COS_TEMP_BUCKET_NAME=your_cos_temp_bucket_name
# COS_TEMP_REGION=your_cos_temp_region
# ----- Volcengine TOS (STORAGE_TYPE=tos) -----
# TOS_ENDPOINT=https://tos-cn-beijing.volces.com
# TOS_REGION=cn-beijing
# TOS_ACCESS_KEY=your_tos_access_key
# TOS_SECRET_KEY=your_tos_secret_key
# TOS_BUCKET_NAME=your_tos_bucket_name
# TOS_PATH_PREFIX=your_tos_path_prefix
# TOS_TEMP_BUCKET_NAME=your_tos_temp_bucket_name
# TOS_TEMP_REGION=your_tos_temp_region
# Configure the following parameters when using AWS S3 for file storage
# AWS S3 endpoint (optional; leave empty to use the standard AWS endpoint for the Region, e.g. https://s3.amazonaws.com)
# ----- AWS S3 (STORAGE_TYPE=s3) -----
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# AWS S3 Access Key (optional; if both AK/SK are empty, use the AWS SDK default credential chain,
# supporting EC2/ECS/EKS IAM Roles, IRSA/Web Identity, environment variables, and shared configuration files)
# AWS S3 Secret Key (must be provided or left empty together with the Access Key)
# S3_SECRET_KEY=your_s3_secret_key
# S3_ACCESS_KEY=your_s3_access_key
# S3_BUCKET_NAME=your_s3_bucket_name
# S3_PATH_PREFIX=weknora/
# S3_USE_SSL=true
# S3_FORCE_PATH_STYLE=false
# ----- Huawei Cloud OBS (STORAGE_TYPE=obs) -----
# OBS_ENDPOINT=obs.cn-north-4.myhuaweicloud.com
# OBS_REGION=cn-north-4
# OBS_ACCESS_KEY=your_obs_access_key
# OBS_SECRET_KEY=your_obs_secret_key
# OBS_BUCKET_NAME=your_obs_bucket_name
# OBS_PATH_PREFIX=weknora/
# OBS_USE_SSL=true
# OBS_PROXY_DOMAIN=https://your-domain.com/obs
# ----- Alibaba Cloud OSS (STORAGE_TYPE=oss) -----
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_REGION=cn-hangzhou
# OSS_ACCESS_KEY=your_oss_access_key
# OSS_SECRET_KEY=your_oss_secret_key
# OSS_BUCKET_NAME=your_oss_bucket_name
# OSS_PATH_PREFIX=weknora/
# OSS_TEMP_BUCKET_NAME=your_oss_temp_bucket_name
# OSS_TEMP_REGION=your_oss_temp_region


# #####################################################################
# C. Retrieval and graphs
# #####################################################################

# ========== C1. Vector databases / retrieval engines ==========
# Vector storage types (comma-separated for multiple drivers): postgres / elasticsearch_v7 / elasticsearch_v8 /
# opensearch / qdrant / milvus / weaviate / doris / tencent_vectordb.
RETRIEVE_DRIVER=postgres
# Multi-vector-database parallel retrieval timeout (seconds; applies when RETRIEVE_DRIVER contains multiple drivers).
# MULTI_STORE_RETRIEVE_TIMEOUT_SEC=
# ----- Elasticsearch v7/v8 -----
# ELASTICSEARCH_ADDR=http://localhost:9200
# ELASTICSEARCH_USERNAME=your_elasticsearch_username
# ELASTICSEARCH_PASSWORD=your_elasticsearch_password
# ELASTICSEARCH_INDEX=WeKnora
# ----- OpenSearch (single-node profile included in dev compose) -----
# OPENSEARCH_ADDR=http://opensearch:9200
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# OPENSEARCH_INSECURE_SKIP_VERIFY=false
# OPENSEARCH_INDEX=WeKnora
# ----- Qdrant -----
# QDRANT_HOST=qdrant
# QDRANT_PORT=6334
# QDRANT_REST_PORT=6333
# QDRANT_COLLECTION=weknora_embeddings
# QDRANT_API_KEY=your_qdrant_api_key
# QDRANT_USE_TLS=false
# ----- Milvus -----
# MILVUS_ADDRESS=milvus:19530
# MILVUS_COLLECTION=weknora_embeddings
# MILVUS_METRIC_TYPE=IP          # IP(default)/COSINE/L2; rebuild the collection after changing it.
# New Collections configure multilingual english/chinese/default analyzers for content;
# for existing Collections, first run go run ./cmd/milvus-migrate (retaining the source Collection's metric),
# then change MILVUS_COLLECTION to the target prefix; do not change MILVUS_METRIC_TYPE.
# MILVUS_USERNAME=your_milvus_username
# MILVUS_PASSWORD=your_milvus_password
# MILVUS_DB_NAME=your_milvus_db_name
# ----- Weaviate -----
# Use service:port for access within containers (not localhost/host-mapped ports).
# WEAVIATE_HOST=weaviate:8080
# WEAVIATE_GRPC_ADDRESS=weaviate:50051
# WEAVIATE_SCHEME=http
# WEAVIATE_AUTH_ENABLED=false    # Set true and configure WEAVIATE_API_KEY only when enabling APIKey/OIDC.
# WEAVIATE_API_KEY=your_secret_key
# WEAVIATE_COLLECTION=your_weaviate_db_name
# ----- Apache Doris 4.1+ -----
# DORIS_ADDR=doris-fe:9030       # FE MySQL protocol address.
# DORIS_HTTP_PORT=8030           # FE HTTP endpoint for Stream Load partial updates.
# DORIS_DATABASE=weknora
# DORIS_USERNAME=root
# DORIS_PASSWORD=
# DORIS_TABLE_PREFIX=weknora_embeddings
# DORIS_COMPAT_MODE=auto         # auto(detection)/legacy(cosine_distance)/inner_product_duplicate; cannot be switched after table creation.
# compose ports.
# DORIS_FE_HTTP_PORT=8030
# DORIS_FE_MYSQL_PORT=9030
# DORIS_BE_HTTP_PORT=8040
# ----- Tencent Cloud Tencent VectorDB -----
# TENCENT_VECTORDB_ADDR=http://your-instance.tencentvectordb.com
# TENCENT_VECTORDB_USERNAME=root
# TENCENT_VECTORDB_API_KEY=your_tencent_vectordb_api_key
# TENCENT_VECTORDB_DATABASE=weknora
# TENCENT_VECTORDB_COLLECTION=weknora_embeddings
# TENCENT_VECTORDB_REPLICA_NUMBER=1

# ========== C2. Knowledge graph (Neo4j, optional) ==========
# The sole global knowledge graph switch. Anything other than true disables graph construction and retrieval (construction calls large language models and takes longer).
# Note: ENABLE_GRAPH_RAG was replaced by NEO4J_ENABLE in v0.1.6; the Go main application no longer reads it, and it has been removed.
# NEO4J_ENABLE=false
# Neo4j connection URI. bolt:// connects directly to a standalone instance (recommended, no routing overhead); neo4j:// uses cluster routing discovery (also works for standalone instances, but requires an extra probe).
# WeKnora deploys standalone Neo4j by default, so bolt:// is used.
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password


# #####################################################################
# D. Models
# #####################################################################

# ========== D1. LLM / VLM / Ollama ==========
# Only warn, without blocking, when Ollama is unavailable (applies when true; non-blocking by default to avoid startup failure when Ollama is not configured).
OLLAMA_OPTIONAL=true
# The sole address for local Ollama. Embedding and chat models with source=local share this process;
# no separate Ollama process is needed for embedding. When unset, the process falls back to http://localhost:11434.
# The embedding model name is not an environment variable: in “Settings → Models”, the CLI, or the initialization API, set the Embedding
# model's name to the Ollama model name (e.g. nomic-embed-text). See the README's Ollama instructions.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Embedding batch size (leave empty for the code default).
# BATCH_EMBED_SIZE=
# Completion token budget for knowledge base description generation (leave empty for the code default of 2048). Reasoning models, even with thinking disabled,
# may exhaust a small budget and fail to generate descriptions (no gist error); increase this value if that occurs.
# KNOWLEDGE_BASE_PROFILE_MAX_TOKENS=
# Timeout for a single VLM HTTP request (seconds, default 180; increase for slow endpoints reporting context deadline timeouts).
# VLM_HTTP_TIMEOUT_SECONDS=180
# Raw LLM stream dump (for troubleshooting context issues; 1 enables it, default directory ~/.weknora/investigate/llm-stream).
# WEKNORA_LLM_STREAM_RAW_DUMP=
# WEKNORA_LLM_STREAM_RAW_DUMP_DIR=

# ========== D2. Declarative built-in model configuration (optional) ==========
# After enabling config/builtin_models.yaml (see config/builtin_models.yaml.example), the YAML's
# ${NAME} placeholders read actual values from here at application startup. Variable names are defined by the YAML; common naming examples follow.
# See website-docs/03-features/06-models.md for details.
#
# Built-in chat model
# LLM_MODEL_NAME=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_PROVIDER=openai
#
# Built-in embedding model. The names below are read only when referenced as ${...} in builtin_models.yaml.
# For local Ollama embedding models, use source: local and name: ${EMBEDDING_MODEL_NAME} (the Ollama model name);
# the address remains OLLAMA_BASE_URL above. EMBEDDING_BASE_URL is only for source: remote APIs.
# See the “one local Ollama” section in config/builtin_models.yaml.example for an example.
# EMBEDDING_MODEL_NAME=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_PROVIDER=openai
#
# Built-in Rerank model
# RERANK_MODEL_NAME=
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_PROVIDER=generic


# #####################################################################
# E. Document parsing
# #####################################################################

# ========== E1. Docreader gRPC and general parsing ==========
# ----- gRPC server TLS / authentication (shared by docreader and app; client/server values must match) -----
# Enable encrypted gRPC TLS transport. Default false (docreader is called only by app within the compose internal network, where plaintext is sufficient).
# GRPC_TLS_ENABLED=false
# Server certificate / client certificate (for mTLS). Required when TLS is enabled on the server.
# GRPC_TLS_CERT=/path/to/server.crt
# Private key corresponding to the certificate.
# GRPC_TLS_KEY=/path/to/server.key
# CA certificate: clients use it to verify the server certificate; for server-side mTLS, use the CA that signs client certificates.
# GRPC_TLS_CA=/path/to/ca.crt
# TLS SNI / certificate verification name. If DOCREADER_ADDR is an IP or differs from the certificate CN, set this to the hostname in the certificate.
# GRPC_TLS_SERVER_NAME=
# Server side: true requires clients to provide certificates (mutual TLS / mTLS).
# GRPC_MTLS_REQUIRE_CLIENT_CERT=false
# gRPC per-RPC authentication token (must match on client/server). Enabling TLS as well is strongly recommended;
# otherwise the token is transmitted in plaintext with every RPC; with GRPC_TLS_ENABLED=true, clients refuse to send tokens over insecure connections.
# GRPC_AUTH_TOKEN=your-secret-token-at-least-16-bytes
# ----- gRPC service parameters -----
# Maximum number of concurrent gRPC server workers (default 4).
# DOCREADER_GRPC_MAX_WORKERS=4
# Maximum size of a single gRPC message (MB, default 50). Usually follows MAX_FILE_SIZE_MB; very large scanned-page images may exceed it.
# DOCREADER_GRPC_MAX_FILE_SIZE_MB=50
# gRPC listening port (default 50051); usually no change is needed, but it must match the docreader port in docker-compose.
# DOCREADER_GRPC_PORT=50051
# ----- General parsing -----
# Maximum pages for DOCX parsing (default 0=unlimited). Set a positive integer (e.g. 500) to limit parsing overhead for very large Word documents.
# DOCREADER_DOCX_MAX_PAGES=0
# Concurrent workers for MarkItDown (heavy parser). 0 disables rate limiting; default 1 suits single-machine/GPU-constrained deployments.
# DOCREADER_MARKITDOWN_MAX_WORKERS=1
# Outbound HTTP/HTTPS proxies (for fetching web pages / remote images).
# DOCREADER_EXTERNAL_HTTP_PROXY=
# DOCREADER_EXTERNAL_HTTPS_PROXY=

# ========== E2. OpenDataLoader hybrid (optional; knowledge base parser_engine_rules specifies engine: opendataloader) ==========
# ODL heavy parser concurrency (default 1).
# DOCREADER_ODL_MAX_WORKERS=1
# Hybrid mode switch: off (default, fast local parsing only) / docling-fast, etc. (requires a separate odl-hybrid container).
# DOCREADER_ODL_HYBRID=off
# odl-hybrid service address. Code default http://127.0.0.1:5002; docker compose injects http://odl-hybrid:5002.
# DOCREADER_ODL_HYBRID_URL=http://odl-hybrid:5002
# Hybrid mode selection (auto); usually no change is needed.
# DOCREADER_ODL_HYBRID_MODE=auto
# Whether to fall back to fast mode when hybrid fails (default false).
# DOCREADER_ODL_HYBRID_FALLBACK=false
# Whether to retain HTML in hybrid Markdown output (default false).
# DOCREADER_ODL_MARKDOWN_WITH_HTML=false
# ----- odl-hybrid container parameters (only used with --profile odl-hybrid) -----
# Extra arguments passed to odl-hybrid. Default --no-ocr (digital PDFs); use --force-ocr for scans (requires EasyOCR+libGL).
# ODL_HYBRID_EXTRA_ARGS=--no-ocr
# Exposed odl-hybrid port (for dev compose mapping).
# ODL_HYBRID_PORT=5002
# Maximum time app waits for odl-hybrid readiness on startup (seconds).
# ODL_HYBRID_STARTUP_WAIT_SEC=180

# ========== E3. PDF rendering ==========
# PDF rendering workers (concurrency across documents, default 1).
# DOCREADER_PDF_RENDER_MAX_WORKERS=1
# Parallel processes for scanned-page rendering within a single PDF (pdfium is not thread-safe, so parallelism uses processes). Default min(4, cpu) based on CPU count; serial rendering of large scans may take hours in CPU-constrained containers, and increasing this can greatly reduce time (measured on 874 pages: 117s->30s/4 processes ->17s/8 processes). Allocate sufficient CPU to the container to benefit from the speedup.
# DOCREADER_PDF_RENDER_PARALLELISM=4
# Rendering DPI (default 200).
# DOCREADER_PDF_RENDER_DPI=200
# JPEG quality of rendered images (default 85).
# DOCREADER_PDF_JPEG_QUALITY=85
# Maximum long-edge pixels for rendered page images (default 2000). Prevents huge pages from producing 100+MP images that exceed gRPC message limits; reducing it further decreases image size, but too small a value impairs OCR (>=1600 recommended for dense Chinese text).
# DOCREADER_PDF_RENDER_MAX_EDGE=2000

# ========== E4. PDF scan detection and forcing ==========
# Force all pages of every PDF to be parsed as scans (render to images, then use OCR/VLM). Suitable for PDFs with poor text layers but OCR-readable pages; enabling this increases processing time and model-call costs. Default false (automatically detected using the thresholds below).
# DOCREADER_PDF_FORCE_SCANNED=false
# Automatic detection: a page is considered scanned if image objects cover >= this fraction of its area (default 0.5).
# DOCREADER_PDF_SCAN_IMAGE_RATIO=0.5
# Automatic detection: a page with fewer text characters than this value is considered to have no usable text layer (default 10).
# DOCREADER_PDF_SCAN_MIN_CHARS=10

# ========== E5. PDF layout / text extraction (native text pages) ==========
# Layout-aware text extraction: reconstruct a readable reading order (default true).
# DOCREADER_PDF_LAYOUT_ORDERING=true
# When glyphs have no explicit space positioning (common in OCR/search text), insert spaces when gaps exceed this multiple of the median character width (default 0.4).
# DOCREADER_PDF_WORD_GAP_WIDTH_RATIO=0.4
# Page-width fraction threshold for discarding narrow sidebars (arXiv sidebar watermarks, page-number labels; default 0.12).
# DOCREADER_PDF_MARGIN_COL_WIDTH_RATIO=0.12
# Minimum characters in a line for font-size heuristics to promote it to a markdown heading (default 8).
# DOCREADER_PDF_MIN_HEADING_LINE_CHARS=8
# Promote visually larger lines to markdown headings (using rect height as a proxy for font size, default true).
# DOCREADER_PDF_DETECT_HEADINGS=true
# Discard invisible text (render-mode 3), off-page text, and degenerate text to prevent hidden-text injection (default true).
# DOCREADER_PDF_FILTER_HIDDEN_TEXT=true
# Clean pdfium placeholders (U+FFFE) and soft hyphens; strip vector chart axis/legend text (default true).
# DOCREADER_PDF_SANITIZE_TEXT=true
# Strip fragmented text in chart regions (used with SANITIZE_TEXT, default true).
# DOCREADER_PDF_STRIP_CHART_DEBRIS=true

# ========== E6. PDF embedded image extraction (native text pages) ==========
# Extract embedded bitmaps from native pages for VLM/OCR analysis (default true).
# DOCREADER_PDF_EXTRACT_EMBEDDED_IMAGES=true
# Minimum pixel width and height for retaining embedded images (default 80; discard smaller images).
# DOCREADER_PDF_EMBED_MIN_PIXELS=80
# Minimum fraction of page area occupied by embedded images; discard below this value (default 0.01).
# DOCREADER_PDF_EMBED_MIN_AREA_RATIO=0.01
# If the same image appears on >= this fraction of text pages, treat it as a recurring element such as a header/footer and deduplicate it (default 0.5).
# DOCREADER_PDF_EMBED_REPEAT_PAGE_FRAC=0.5
# Hard limit on embedded images extracted per document (default 50).
# DOCREADER_PDF_EMBED_MAX_IMAGES=50

# ========== E7. PDF chart region detection (vector graphic regions) ==========
# Render detected vector chart regions (without embedded bitmaps) to JPEG for VLM/OCR (default true).
# DOCREADER_PDF_RENDER_VECTOR_FIGURES=true
# Minimum characters per line required for a region to be considered a chart (default 18).
# DOCREADER_PDF_MIN_CHART_REGION_CHARS=18
# Minimum area fraction required for a region to be considered a chart (default 0.015).
# DOCREADER_PDF_MIN_CHART_REGION_AREA=0.015
# Maximum area fraction for a region to be considered a chart (larger regions are not treated as charts, default 0.42).
# DOCREADER_PDF_MAX_CHART_REGION_AREA=0.42
# Maximum graphic height as a fraction of page height; taller graphics are not treated as standalone charts (default 0.38).
# DOCREADER_PDF_MAX_FIGURE_HEIGHT_RATIO=0.38

# ========== E8. Document processing / task timeouts ==========
# Total timeout for a single-document processing task (Go duration, default 2h; increase for large files).
# WEKNORA_DOCUMENT_PROCESS_TIMEOUT=2h
# Timeout for a single DocReader RPC (default 30m; must be less than the previous setting).
# WEKNORA_DOCREADER_CALL_TIMEOUT=30m
# Self-hosted PaddleOCR-VL HTTP request timeout (positive Go duration, default 1000s; invalid values fall back to the default).
# Large-file example: this setting 90m, DocReader 100m, single-document task 2h; allow headroom in outer timeouts.
# WEKNORA_PADDLEOCR_VL_TIMEOUT=1000s
# Self-hosted MinerU timeout for a single parse (positive Go duration, default 1000s; invalid values fall back to the default).
# Very large PDFs also need headroom in outer timeouts, e.g. this setting 90m, DocReader 100m, single-document task 2h.
# WEKNORA_MINERU_TIMEOUT=1000s
# Maximum time to poll parsing results from MinerU Cloud (mineru.net) (positive Go duration, default 600s).
# WEKNORA_MINERU_CLOUD_TIMEOUT=600s
# Maximum time to poll parsing results from PaddleOCR-VL Cloud (AI Studio) (positive Go duration, default 600s).
# WEKNORA_PADDLEOCR_VL_CLOUD_TIMEOUT=600s
# Maximum time to poll task results from WeKnoraCloud-hosted docreader (positive Go duration, default 20m; should be less than WEKNORA_DOCREADER_CALL_TIMEOUT).
# WEKNORA_WEKNORACLOUD_TIMEOUT=20m
# Knowledge base housekeeping (recovers dirty data stuck in processing; false disables it, not recommended).
# WEKNORA_HOUSEKEEPING_ENABLED=true
# Retention time for chat attachment parsing outputs (hours, default 24).
# WEKNORA_CHAT_ATTACHMENT_TTL_HOURS=24
# Maximum wait for attachment parsing in a single Q&A turn (seconds, default 60; increase for large files/scans).
# WEKNORA_CHAT_ATTACHMENT_WAIT_TIMEOUT_SEC=60
# Attachment VLM OCR tuning (scans/image-based documents): concurrency / maximum pages.
# WEKNORA_CHAT_ATTACHMENT_OCR_CONCURRENCY=8
# WEKNORA_CHAT_ATTACHMENT_OCR_MAX_PAGES=8

# ========== E9. Feishu cloud document parsing mode ==========
# Controls the parsing path when syncing newer cloud documents (docx) from Feishu Drive / Feishu Wiki:
#   export (default; leave empty): use the asynchronous export API to download the .docx binary, then pass it to docreader
#     for parsing. Images are inlined into the parent document (associated with the same knowledge via parent_chunk_id), so retrieval /
#     wiki / agents can all associate image content with the document. Tradeoff: slower syncing; attachments in Feishu docx
#     file blocks are not downloaded with the export (lost unless synced separately); if cloud documents contain spreadsheets,
#     multidimensional tables, etc., export turns them into tables embedded in docx that weknora cannot parse.
#   blocks: use the blocks API to convert to Markdown. Fast and preserves attachments within docx; however, images render as empty
#     `![image]()` placeholders and are stored as separate knowledge entries, without content association to the parent document (retrieval /
#     wiki / agents cannot link images back to the document); spreadsheets are parsed into markdown tables,
#     with a risk of losing formatting such as merged cells.
# Set blocks when image association is unnecessary, speed is preferred, attachments must be retained, or spreadsheet formatting must be preserved.
# This is a temporary solution; if a better parsing solution becomes available, this environment variable will be removed and replaced.
# FEISHU_DOCX_PARSE_MODE=export

# Feishu export creation / status queries / downloads and Wiki child-node listings each share a per-application quota (within one process).
# Default 80 requests/minute per endpoint, evenly paced without accumulating burst capacity; positive integers override the default.
# FEISHU_API_REQUESTS_PER_MINUTE=80
# Wait duration when a rate-limit response provides no valid wait hint (Go duration, default 10s).
# FEISHU_RATE_LIMIT_RETRY_WAIT=10s
# Maximum wait for each shared cooldown, including response-header hints and the default wait above (Go duration).
# FEISHU_RATE_LIMIT_MAX_WAIT=5m
# Maximum export-task polls; rate-limit retries and queuing do not consume poll attempts, and the task context remains cancellable.
# FEISHU_EXPORT_MAX_POLLS=30
# Interval between export-task polls (Go duration).
# FEISHU_EXPORT_POLL_INTERVAL=2s

# #####################################################################
# F. Authentication and tenant isolation
# #####################################################################

# ========== F1. Keys ⚠️ Required (change defaults in production) ==========
# JWT signing key for frontend login refresh tokens (randomly generated on startup if empty).
# Generate once: openssl rand -hex 32
JWT_SECRET=
# AES-256 master key for encrypting sensitive database fields such as API Keys at rest (must be 32 bytes).
# Encryption scope: tenants.api_key, model API keys, vector database credentials, web search provider keys,
# WeKnoraCloud.AppSecret, etc. If missing or the wrong length, encrypted fields cannot be decrypted (shown empty in the UI and must be re-entered).
# Must be explicitly set and safely retained in production; losing it makes all encrypted data unrecoverable.
# Note: TENANT_AES_KEY / CRYPTO_MASTER_KEY / CRYPTO_SALT are obsolete. Since v0.4.0, CryptoService (PBKDF2) has been removed and all encryption uses SYSTEM_AES_KEY. The Go main application no longer reads these three variables, and they have been removed.
# Generate once: openssl rand -hex 16 (32 ASCII bytes); retain existing keys on upgrade.
SYSTEM_AES_KEY=
# Optional independent signing key for embed sessions and presigned URLs.
# Generate once: openssl rand -hex 32. Falls back to a valid SYSTEM_AES_KEY.
SYSTEM_SIGNING_KEY=

# ========== F2. Registration and tenant policies ==========
# Disable new user registration (true recommended in production).
# DISABLE_REGISTRATION=false
# When enabled, passwords must contain uppercase and lowercase letters, digits, and special characters; special characters include: !@#$%^&*()_+-=[]{}|;:,.<>?
# WEKNORA_AUTH_COMPLEX_PASSWORD_ENABLED=false
# Default tenant policy after public registration: create_personal (default, automatically creates a personal tenant) / tenantless.
# WEKNORA_AUTH_DEFAULT_TENANT_MODE=create_personal
# Whether regular users can create tenants after login (default true; false allows joining only by invitation; system administrators are unaffected).
# WEKNORA_TENANT_SELF_SERVICE_CREATION_ENABLED=true
# Enable tenant-level RBAC (true enforces authorization by default / false is observation mode: role checks within a tenant only log and do not block; cross-tenant access is always blocked).
# WEKNORA_TENANT_ENABLE_RBAC=true
# Enable cross-tenant access (requires the user's CanAccessAllTenants permission; default false). For cross-tenant administrators, manually update the database to grant the corresponding users cross-tenant administration privileges
# WEKNORA_TENANT_ENABLE_CROSS_TENANT_ACCESS=false
# Maximum tenants a single non-system-administrator user can create through self-service (>0 enforces the limit; =0 uses the default; <0 disables the limit).
# WEKNORA_TENANT_MAX_OWNED_PER_USER=
# Whether to automatically generate a full_access API Key and return its token when creating a tenant (default false; legacy compatibility fallback switch).
# WEKNORA_TENANT_AUTO_CREATE_API_KEY=false
# Default storage quota for new tenants (GB, default 10).
# WEKNORA_TENANT_DEFAULT_STORAGE_QUOTA_GB=10
# Tenant invitation link TTL (Go duration, default 168h=7 days).
# WEKNORA_INVITATION_TTL=168h
# Global switch: immediately add existing registered users to tenants when invited. Default false; adjustable on the system settings page.
# WEKNORA_TENANT_AUTO_ACCEPT_INVITATION=false
# Audit log retention in days (0 disables cleanup, default 90).
# WEKNORA_AUDIT_RETENTION_DAYS=90

# ========== F3. OIDC authentication (optional, enabled by OIDC_AUTH_ENABLE=true) ==========
# OIDC_AUTH_ENABLE=false
# OIDC_AUTH_ISSUER_URL=http://127.0.0.1:5556/dex
# OIDC_AUTH_DISCOVERY_URL=http://127.0.0.1:5556/dex/.well-known/openid-configuration
# OIDC_AUTH_PROVIDER_DISPLAY_NAME=OIDC
# OIDC_AUTH_CLIENT_ID=client_id_for_oidc_client
# OIDC_AUTH_CLIENT_SECRET=secret_for_oidc_client
# If OIDC_AUTH_DISCOVERY_URL is set, the following endpoints can be empty. Even if authorization/Token endpoints are explicitly set,
# discovery still fills in jwks_uri or issuer if either is empty, for id_token verification.
# OIDC_AUTH_AUTHORIZATION_ENDPOINT=http://127.0.0.1:5556/dex/auth
# OIDC_AUTH_TOKEN_ENDPOINT=http://127.0.0.1:5556/dex/token
# OIDC_AUTH_USER_INFO_ENDPOINT=http://127.0.0.1:5556/dex/userinfo
# OIDC_AUTH_JWKS_URI=http://127.0.0.1:5556/dex/keys
# OIDC_AUTH_SCOPES="openid profile email"
# The tenant policy after first-time automatic OIDC account creation shares WEKNORA_AUTH_DEFAULT_TENANT_MODE with local registration; no separate setting.
# OIDC_USER_INFO_MAPPING_USER_NAME=name
# OIDC_USER_INFO_MAPPING_EMAIL=email


# #####################################################################
# G. Agents and sandboxes
# #####################################################################

# ========== G1. Agent Skills Sandbox ==========
# Sandbox backends, credentials, templates, timeouts, and private-network access policies are all maintained per tenant
# in “Settings → Sandbox Backends”. The only deployment-level switch is for the Docker backend: disabled by default because local
# docker.sock is equivalent to host root access; enable it for self-hosted single-machine deployments when needed, or have a system administrator enable it in
# “Settings → System Settings → Network Security” (effective immediately, without restarting).
WEKNORA_SANDBOX_DOCKER_ENABLED=false
# Multi-instance deployments should still configure the shared REDIS_ADDR for shared session→sandbox binding.

# Default agent large language model call timeout (seconds, default 120; increase to e.g. 300/600 for complex reasoning).
# Note: global default; an individual agent's independent llm_call_timeout setting in the database takes precedence.
# WEKNORA_AGENT_LLM_TIMEOUT=300
# Timeout waiting for human review of MCP tools (seconds, default 600; also supports Go durations such as 30s/5m/1h).
# WEKNORA_AGENT_TOOL_APPROVAL_TIMEOUT=600
# Whether to allow MCP tools when human approval fails (true allows / default fail-close denies).
# WEKNORA_AGENT_TOOL_APPROVAL_FAIL_OPEN=


# #####################################################################
# H. Optional integrations
# #####################################################################

# ========== H1. Web search (SearXNG / Tavily) ==========
# ===== SearXNG (optional self-hosted web search) =====
# Enable: `docker compose --profile searxng up -d`.
# When SEARXNG_SECRET is unset, the hardcoded docker-compose default is used, which is sufficient for local/loopback deployments;
# if you set SEARXNG_BIND=0.0.0.0 to expose the instance to the LAN/public internet, be sure to generate a secret with openssl rand -hex 32
# and explicitly set SEARXNG_SECRET; otherwise anyone can use the default to sign image-proxy URLs.
#
# Backend access (containerized deployment): select Provider type “SearXNG” in the console,
# and set Instance URL to http://searxng:8080; docker compose injects the searxng hostname into
# SSRF_WHITELIST_EXTRA by default, with no extra configuration needed.
#
# Local development (go run + docker compose -f docker-compose.dev.yml --profile searxng up):
# the backend runs on the host and must use the published port; set Instance URL to http://127.0.0.1:8888,
# and add 127.0.0.1 to SSRF_WHITELIST below.
#
# The port listens only on 127.0.0.1 by default to avoid exposing an instance with limiter:false to the LAN.
# To expose it to the internal network, explicitly override SEARXNG_BIND=0.0.0.0 and harden it yourself.
# SEARXNG_PORT=8888
# Do not set SEARXNG_PORT to the same value as APP_PORT (default 8080).
# On Linux, binding SearXNG to 127.0.0.1:8080 while the app also publishes
# :8080 makes localhost:8080 hit SearXNG first — POST /api/v1/auth/login
# then returns SearXNG's HTML 404 even though DISABLE_REGISTRATION only
# closes registration (see discussion on issue #3296). Keep SearXNG on 8888
# (or another free port).
# SEARXNG_BIND=127.0.0.1
# SEARXNG_SECRET=
# Tavily Search API Key (optional, enables the Tavily web search provider).
# TAVILY_API_KEY=tvly-your_tavily_api_key

# ========== H2. MCP Server (optional, starts with --profile full) ==========
# API Key used by MCP Server to access the WeKnora REST API (generate in frontend “Settings -> API Keys”).
# WEKNORA_API_KEY=
# Required for HTTP/SSE transport: mcp-server refuses to start if missing (clients send it via Authorization: Bearer).
# MCP_SERVER_AUTH_TOKEN=
# Read timeout for WeKnora REST calls (seconds, default 300).
# WEKNORA_CHAT_TIMEOUT=300
# Whether to verify the WeKnora backend TLS certificate (default true; set false for self-signed certificates).
# WEKNORA_VERIFY_SSL=true
# Allowlist of upload directories (comma-separated; leave empty to disable the file upload tool).
# MCP_ALLOWED_UPLOAD_DIRS=


# #####################################################################
# I. Observability (Langfuse, optional)
# #####################################################################

# ========== I1. Langfuse integration (traces chat/embedding/rerank/VLM/ASR model calls and tracks token usage) ==========
# Details: website-docs/03-features/16-observability.md
#
# Option A: Connect to Langfuse Cloud (simplest)
#   1) Sign in to https://cloud.langfuse.com and generate API Keys
#   2) Enter PUBLIC_KEY / SECRET_KEY below
#   3) docker compose up -d app
#
# Option B: Self-host Langfuse (LAN/internal network environments)
#   1) Start the self-hosted stack: docker compose --profile langfuse up -d
#      ClickHouse migrations take about 1-2 minutes after initial startup; wait for langfuse-web to become healthy
#   2) Open http://localhost:3000 in a browser, register an administrator account, and generate API Keys
#   3) Uncomment LANGFUSE_HOST=http://langfuse-web:3000 below and enter the newly generated PUBLIC_KEY / SECRET_KEY
#   4) docker compose up -d app
#
# Automatically enabled when both PUBLIC_KEY + SECRET_KEY are set; no explicit switch is needed.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=http://langfuse-web:3000
# For self-hosted mode, change to: LANGFUSE_HOST=http://langfuse-web:3000
# Optional: explicit switch (true/false; default determined automatically from keys).
# LANGFUSE_ENABLED=true
# Optional: version / environment labels for filtering in the Langfuse UI.
# LANGFUSE_RELEASE=v0.4.2
# LANGFUSE_ENVIRONMENT=production
# Optional: batch reporting and sampling strategy (for high production traffic, increase FLUSH_AT and reduce SAMPLE_RATE).
# LANGFUSE_FLUSH_AT=15
# LANGFUSE_FLUSH_INTERVAL=3s
# LANGFUSE_QUEUE_SIZE=2048
# LANGFUSE_REQUEST_TIMEOUT=10s
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_DEBUG=false

# ========== I2. Langfuse self-hosted stack configuration (only needed with --profile langfuse) ==========
# Design note: to minimize resource usage, the self-hosted Langfuse stack **reuses** WeKnora's existing
#   - postgres: creates a separate “langfuse” database (created once by the langfuse-db-init container)
#   - redis   : uses a separate Redis DB index (default 1; WeKnora uses 0)
# Only 3 persistent containers are actually added: langfuse-web, langfuse-worker, langfuse-clickhouse
#                         + 1 dedicated S3: langfuse-minio
#                         + 1 one-time init: langfuse-db-init
# Exposed Langfuse Web UI port.
# LANGFUSE_WEB_PORT=3000
# Dedicated Langfuse MinIO ports (avoid conflicts with WeKnora's primary MinIO ports 9000/9001).
# LANGFUSE_MINIO_S3_PORT=9100
# LANGFUSE_MINIO_CONSOLE_PORT=9101
# External endpoint for media uploads (browser connects directly to Langfuse MinIO), default points to host-mapped port 9100.
# LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9100
# Langfuse database name created in WeKnora-postgres.
# LANGFUSE_DB_NAME=langfuse
# DB index used in WeKnora-redis (1~15; avoid conflicting with WeKnora's 0).
# LANGFUSE_REDIS_DB=1
# ClickHouse / dedicated Langfuse MinIO credentials (must be changed in production).
# LANGFUSE_CLICKHOUSE_USER=clickhouse
# LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
# LANGFUSE_MINIO_USER=langfuseminio
# LANGFUSE_MINIO_PASSWORD=langfuseminiosecret
# Core Langfuse security fields; regenerate for production:
#   LANGFUSE_SALT=$(openssl rand -base64 32)
#   LANGFUSE_ENCRYPTION_KEY=$(openssl rand -hex 32)
#   LANGFUSE_NEXTAUTH_SECRET=$(openssl rand -base64 32)
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_NEXTAUTH_URL=http://localhost:3000
# LANGFUSE_TELEMETRY_ENABLED=false
# Optional: automated first startup (populate to inject an administrator+project directly, skipping UI registration).
# LANGFUSE_INIT_ORG_ID=WeKnora
# LANGFUSE_INIT_ORG_NAME=WeKnora
# LANGFUSE_INIT_PROJECT_ID=WeKnora
# LANGFUSE_INIT_PROJECT_NAME=WeKnora
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-weknora-init
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-weknora-init
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_NAME=Admin
# LANGFUSE_INIT_USER_PASSWORD=change-me-please


# #####################################################################
# J. Security and deployment tuning
# #####################################################################

# ========== J1. SSRF protection ==========
# SSRF validation allowlist (optional). Comma-separated; each entry can be an exact domain (api.internal), wildcard domain (*.example.com),
# IPv4 (203.0.113.5), IPv6 (2001:db8::1, without brackets), or CIDR (10.0.0.0/8, 2001:db8::/32).
# Listed entries bypass standard SSRF rules in URL validation and elsewhere; configure carefully in production.
# SSRF_WHITELIST=internal.service,*.corp.example,172.16.0.0/12,2001:db8::1,fd00::/8
#
# Allow only allowlisted outbound connections (disabled by default). When true, the allowlist defines the entire outbound policy: hosts not in SSRF_WHITELIST /
# SSRF_WHITELIST_EXTRA (including direct IP connections) are rejected before DNS queries; domains match only by name,
# not against CIDRs using resolved addresses. Recommended for offline/internal deployments; allowlist all model, vector database, object storage, and other addresses.
# SSRF_DNS_WHITELIST_ONLY=false
#
# Outbound dial timeout (Go duration, default 5s): connections to external endpoints such as models and connectors fail if not established within this time.
# Increase for serverless endpoints with slow cold starts, e.g. 15s.
# WEKNORA_OUTBOUND_DIAL_TIMEOUT=5s
#
# ===== SSRF validation of vector database addresses =====
# Addresses are SSRF-validated when creating/testing vector database connections via the API. Built-in docker-compose services
# (qdrant, milvus, weaviate, doris-fe, doris-be, searxng, minio) are allowed by default through SSRF_WHITELIST_EXTRA.
# For external private-network addresses or blocked ports (5432, 9200, etc.), add the host to SSRF_WHITELIST_EXTRA
# (note: customizing this variable overrides the compose defaults, so include the built-in service names again), e.g.:
#   SSRF_WHITELIST_EXTRA=searxng,qdrant,milvus,weaviate,doris-fe,doris-be,minio,my-opensearch.internal
#
# Doris Stream Load: FE redirects requests to BE with a 307; docker compose allows
# doris-fe and doris-be by default (see SSRF_WHITELIST_EXTRA).
#
# Local development (go run + docker-compose.dev.yml --profile opensearch): the backend runs on the host,
# and accesses OpenSearch through the published port at http://localhost:9200; before creating this vector database via the API,
# add localhost to SSRF_WHITELIST (9200 is a blocked port, and localhost is a restricted hostname):
#   SSRF_WHITELIST=localhost
# Allowlist of image domains whose original URLs are retained (optional, comma-separated). Images from these domains are still downloaded for analysis
# (OCR/captioning), but markdown retains the original URL rather than replacing it with the object storage provider:// URL.
# IMAGE_HOST_KEEP_URL=mineru.internal.example.com

# ========== J2. Proxies and concurrency ==========
# Proxy CIDRs trusted by gin (comma-separated). Default trusts loopback + private network ranges (covers nginx within the container network).
# Explicitly setting an empty string disables proxy trust (ClientIP returns the directly connected peer). For production behind multiple proxy layers, configure according to the actual setup.
# WEKNORA_TRUSTED_PROXIES=
# ants goroutine pool size (Embedding concurrency; reduce when encountering 429 responses).
CONCURRENCY_POOL_SIZE=5

# ========== J3. BrowserSkill local browser (optional) ==========
# Users connect through the Chrome extension; see website-docs/05-clients/09-local-browser.md for deployment and limitations.
# The Docker app image includes bsk and the companion extension; the connection address is generated automatically from the user's current page by default, without configuring PUBLIC_URL.
# Native deployments also need build artifacts and the two file paths below; explicitly setting BROWSERSKILL_BINARY= disables this feature.
# Absolute path to the official bsk executable for the backend's OS/architecture (preset in Docker; no need to configure again).
# BROWSERSKILL_BINARY=/opt/weknora/browserskill/bsk
# Optional override: set only for special deployments where the gateway uses a separate domain/path; remote deployments must use WSS (including internal networks).
# BROWSERSKILL_PUBLIC_URL=wss://weknora.example.com/api/v1/local-browser/extension
# One daemon is shared by each application instance; maximum retained user pairing records (default 32, not measured capacity).
# BROWSERSKILL_MAX_CONNECTIONS=32
# Companion extension ZIP for download from personal settings (absolute local server path, preset in Docker).
# BROWSERSKILL_EXTENSION_PATH=/opt/weknora/browserskill/browser-skill-weknora-0.3.1.zip
# Multiple replicas: give each node an address directly reachable by other nodes; do not use a load-balanced address.
# BROWSERSKILL_INTERNAL_URL=http://10.0.0.12:8080
# All replicas use the same random key (at least 32 characters), injected from a Secret and not committed to the repository.
# BROWSERSKILL_CLUSTER_SECRET=
