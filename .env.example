# =====================================================================
# WeKnora 환경 변수 설정 예시
# ---------------------------------------------------------------------
# 사용 방법:
#   1. 이 파일을 .env로 복사합니다: cp .env.example .env
#   2. 모든 플레이스홀더를 실제 값으로 바꿉니다(특히 ⚠️ 필수 표시 항목).
#   3. .env가 버전 관리에 커밋되지 않도록 합니다.
#
# 설정 주입 방식:
#   - app 서비스는 env_file: .env를 통해 이 파일의 모든 변수를 읽습니다.
#   - docreader / mcp / frontend / odl-hybrid 서비스에는 env_file이 없으며, 각 서비스의
#     environment 항목에 명시된 변수만 사용합니다(docker-compose.yml 참조).
#
# 그룹 순서:
#   A. 배포 기본 설정    이미지, 런타임, 네트워크
#   B. 데이터 및 저장소  데이터베이스, Redis, 파일 저장소, 객체 저장소
#   C. 검색 및 그래프    벡터 데이터베이스, 지식 그래프
#   D. 모델              LLM/VLM/Ollama, 내장 모델
#   E. 문서 파싱         Docreader, 작업 타임아웃
#   F. 인증 및 공간 격리 JWT/AES, 회원가입, RBAC, OIDC
#   G. Agent 및 샌드박스 Sandbox, Skills, Agent 타임아웃
#   H. 선택적 연동       웹 검색, MCP Server
#   I. 관측 가능성       Langfuse
#   J. 보안 및 튜닝      SSRF, 프록시, 동시성
# =====================================================================


# #####################################################################
# A. 배포 기본 설정
# #####################################################################

# ========== A1. 이미지 버전 및 빌드 ==========
# WeKnora 이미지 버전 태그: latest(안정 버전) / main(최신 개발 버전). 특정 버전으로 업그레이드할 때는 대상 release의 git tag(예: v0.7.0, v 접두사에 주의)를 입력하고 docker compose pull로 해당 이미지를 가져옵니다.
WEKNORA_VERSION=latest
# Debian APT 미러 호스트 이름(app 이미지 빌드용, 비워 두면 기본 저장소 사용; 중국 내에서는 mirrors.tencent.com으로 설정하면 다운로드 속도를 높일 수 있습니다).
APK_MIRROR_ARG=mirrors.tencent.com
# app 이미지 빌드 시 anydoc 인프로세스 파싱 엔진을 링크할지 여부(기본값 1). 0으로 설정하면 Rust 도구 체인을 생략하여 빌드 시간을 줄일 수 있으며, 설정 페이지에서 엔진이 사용 불가로 표시됩니다.
# WITH_ANYDOC=1
# docreader 이미지 빌드 시 apt 미러(비워 두면 기본 저장소 사용).
# APT_MIRROR=
# docreader 이미지 빌드 시 Playwright 브라우저 아티팩트 다운로드 소스(비워 두면 공식 CDN 사용).
# PLAYWRIGHT_DOWNLOAD_HOST=
# WebKit 아티팩트 다운로드 소스만 재정의하며, 설정 시 PLAYWRIGHT_DOWNLOAD_HOST보다 우선합니다.
# PLAYWRIGHT_WEBKIT_DOWNLOAD_HOST=
# 소스에서 frontend 이미지를 빌드할 때 시스템 정보 페이지에 표시할 짧은 commit 해시입니다. make docker-build-frontend
# 및 start_all.sh --no-pull은 git에서 자동으로 채웁니다. docker compose build를 직접 실행할 때는 직접 환경 변수로 내보내야 하며, 그렇지 않으면 unknown이 표시됩니다.
# VITE_FRONTEND_COMMIT=
# frontend 이미지 빌드 시 npm registry(비워 두면 기본 저장소 사용; 중국 내에서는 https://registry.npmmirror.com으로 설정 가능).
# NPM_REGISTRY=
# Vite 빌드 시 Node 힙 크기 상한(MB). Docker Desktop에 할당된 메모리가 적으면 2048로 낮출 수 있습니다.
# NODE_MAX_OLD_SPACE_SIZE=4096

# ========== A2. 런타임 기본 설정 ==========
# gin 실행 모드: debug(개발, 상세 로그 + Swagger) / release(운영, Swagger 비활성화).
GIN_MODE=release
# 로그 수준: debug / info / warn / error / fatal, 기본값 debug.
# LOG_LEVEL=debug
# 로그 파일 경로(비워 두면 stdout에만 출력); LLM_DEBUG_LOG가 활성화되면 같은 디렉터리에 llm_debug.log를 기록합니다.
# LOG_PATH=
# 사용자 지정 로그 형식 템플릿(비워 두면 내장 기본 형식 사용).
# LOG_FORMAT=
# LLM 디버그 로그: 대형 언어 모델 호출별 전체 요청/응답을 별도 파일에 기록하여 컨텍스트 문제를 진단합니다.
# 가능한 값: true(LOG_PATH와 같은 디렉터리의 llm_debug.log에 기록) / false 또는 빈 값(비활성화) / 지정 파일 경로.
# LLM_DEBUG_LOG=true
# 시간대, 기본값 Asia/Shanghai. 시스템 시간 표시와 로그 타임스탬프에 영향을 줍니다.
# 자주 사용하는 값: Asia/Shanghai, Asia/Tokyo, America/New_York, Europe/London, UTC.
TZ=Asia/Shanghai
# 시스템 기본 언어(BCP-47). Prompt의 {{language}} 플레이스홀더에 사용할 대체 언어입니다.
# 우선순위: Accept-Language 요청 헤더 > 이 변수 > 내장 기본값 (en-US).
WEKNORA_LANGUAGE=ko-KR
# 프런트엔드 UI 기본 언어(BCP-47). 선택 가능: zh-CN | zh-TW | en-US | ru-RU | ko-KR | ja-JP.
# 우선순위: 사용자가 선택한 언어(localStorage) > 이 변수 > 내장 기본값 zh-CN.
# 처음 방문하거나 언어를 수동으로 변경하지 않은 사용자에게만 적용됩니다. 변경 후 frontend 컨테이너를 재시작하면 적용되며 이미지를 다시 빌드할 필요는 없습니다.
DEFAULT_LOCALE=ko-KR
# 프런트엔드 이미지 빌드 시 기본 대체 언어(Docker 런타임 config.js를 사용하지 않을 때만 적용).
# VITE_DEFAULT_LOCALE=en-US
# 시작 시 데이터베이스 마이그레이션을 자동 실행합니다. false로 설정하면 비활성화됩니다(기본 활성화).
AUTO_MIGRATE=true
# 더티 상태의 마이그레이션을 자동 복구합니다(기본값 true).
AUTO_RECOVER_DIRTY=true
# 시작 시 지정한 email의 사용자를 시스템 관리자로 자동 승격합니다(멱등성 보장; PROMOTE만 수행하고 DEMOTE는 하지 않음).
# docker-compose/k8s 최초 부트스트랩용입니다. 이후 권한 부여/회수는 SystemAdmin 관리 페이지에서 수행합니다.
# WEKNORA_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=

# ========== A3. 네트워크 및 외부 주소 ==========
# 애플리케이션 서비스 호스트 이름, 기본값 app(Docker 내부 서비스 이름). 원격 백엔드는 원격 주소로 설정할 수 있습니다.
APP_HOST=app
# 애플리케이션 서비스의 호스트 매핑 포트, 기본값 8080(호스트에서의 접근에만 영향을 주며 컨테이너 간 통신에는 영향 없음).
APP_PORT=8080
# NGINX가 백엔드로 프록시할 대상 포트, 기본값 8080(App 컨테이너 내부 수신 포트).
# 로컬 배포에서는 기본값을 유지하고, 원격 배포에서는 원격 App 서비스의 실제 포트로 설정합니다.
# APP_BACKEND_PORT=8080
# NGINX가 백엔드로 프록시할 프로토콜, 기본값 http. 원격 백엔드가 HTTPS이면 https로 설정합니다.
# APP_SCHEME=http
# 프런트엔드 서비스 포트, 기본값 80.
FRONTEND_PORT=80
# Docreader 주소(app에서 docreader 연결 시 사용).
DOCREADER_ADDR=docreader:50051
# Docreader 연결 방식: grpc / http / https.
DOCREADER_TRANSPORT=grpc
# 애플리케이션 외부 접근 주소(IM 채널의 이미지/파일 외부 링크에 영향을 줌).
# IM 플랫폼/클라이언트가 공용 인터넷에서 접근할 수 있는 WeKnora 인스턴스 URL(예: https://weknora.example.com)로 설정합니다.
# IM에서 지식 베이스 이미지를 표시하려면 IM 측에서 공용 인터넷 http URL로 이미지를 가져올 수 있어야 합니다. 다음 중 하나를 선택합니다.
#   (A) 저장소 백엔드 자체가 공용 인터넷에서 접근 가능(객체 저장소에 공용 endpoint 사용 또는 MINIO_ENDPOINT를 공용 host로 설정).
#      이 경우 resource://는 백엔드의 사전 서명 URL을 사용하므로 이 변수가 필요하지 않습니다.
#   (B) 이 변수를 설정하면 resource:// 이미지 주소를 <APP_EXTERNAL_URL>/r/<token>으로 바꾸어 WeKnora를 거칩니다(nginx의 /r/ 프록시 필요).
# 기본 MinIO 배포(minio:9000은 내부망)에서는 (B)가 가장 간단합니다. local 백엔드는 (B)만 사용할 수 있습니다.
# 내부망 IP와 localhost는 Feishu/WeCom/Slack 등의 IM 플랫폼에서 접근할 수 없습니다. 로컬 개발에는 ngrok/cloudflared/frp를 사용하세요.
# APP_EXTERNAL_URL=
# 프런트엔드 외부 origin. 초대 링크 등의 절대 URL에 사용합니다(비워 두면 호스트 기준 상대 주소 사용).
# FRONTEND_BASE_URL=
# API 응답에서 파일 참조의 기본 형식: handle(기본값) / public.
#   handle — 내부 resource://<handle>을 반환하며, 클라이언트는 인증이 필요한 /files 프록시를 추가 호출하여 이미지를 가져와야 합니다.
#   public — 바로 로드할 수 있는 http(s) 링크를 반환하므로 타사 App에서 추가 요청 없이 렌더링할 수 있습니다.
# 개별 요청에서는 ?resource_urls=handle|public으로 이 변수를 재정의할 수 있습니다. 적용 범위는 README의 "API 참조"를 확인하세요.
# public으로 외부 링크를 생성하려면 위의 APP_EXTERNAL_URL이 설정되어 있거나 저장소 백엔드 자체가 공용 인터넷에서 접근 가능해야 합니다.
# 링크를 생성할 수 없으면 해당 참조는 resource:// 그대로 유지되며, 클라이언트는 /files를 대체 경로로 사용할 수 있습니다.
# 주의: public은 참조된 각 파일에 대해 유효 시간이 제한된(WeKnora 2시간 / MinIO 24시간) 익명 읽기 링크를 발급합니다.
# 익명 embed 채널과 지식 베이스 범위가 제한된 API Key는 이 변수의 영향을 받지 않으며 항상 handle을 반환합니다.
# grant 행을 재사용하고 직접 링크 URL을 안정적으로 유지하며 읽기 API의 쓰기 부하를 줄이려면 SYSTEM_AES_KEY도 함께 설정하는 것이 좋습니다.
# RESOURCE_URL_MODE=handle
# 외부에 노출할 MCP Server 포트(기본값 8082).
# MCP_PORT=8082


# #####################################################################
# B. 데이터 및 저장소
# #####################################################################

# ========== B1. 데이터베이스 ⚠️ 필수 ==========
# 기본 데이터베이스 유형: postgres / sqlite. sqlite는 Lite 모드용이며 DB_PATH를 참조하세요.
DB_DRIVER=postgres
# 데이터베이스 호스트 주소.
DB_HOST=postgres
# 데이터베이스 포트.
DB_PORT=5432
# 데이터베이스 사용자 이름.
DB_USER=postgres
# 데이터베이스 비밀번호.
DB_PASSWORD=postgres123!@#
# 데이터베이스 이름.
DB_NAME=WeKnora
# SQLite 드라이버(DB_DRIVER=sqlite)에서 사용하며, postgres 드라이버에서는 무시합니다.
# DB_PATH=./data/weknora.db

# ========== B2. Redis / 스트림 처리 / Asynq 큐 ==========
# --- 스트림 처리 백엔드 및 Redis 연결 ---
# 스트림 처리 백엔드: memory / redis. redis 모드에서는 Asynq 작업 큐도 이 Redis를 사용합니다.
STREAM_MANAGER_TYPE=redis
# Redis 주소(비워 두면 Redis 비활성화, Lite 모드에서는 memory 사용).
REDIS_ADDR=redis:6379
# Redis 사용자 이름(Redis 6.0+ ACL, 선택 사항).
# REDIS_USERNAME=
# Redis 비밀번호. 설정하지 않은 경우 비워 둘 수 있습니다.
REDIS_PASSWORD=redis123!@#
# Redis 데이터베이스 인덱스, 기본값 0.
REDIS_DB=0
# Redis key 접두사. 네임스페이스 격리에 사용합니다.
REDIS_PREFIX=stream:
# Redis 채널 네임스페이스 접미사(여러 배포가 같은 Redis를 공유할 때 격리용).
# WEKNORA_REDIS_NAMESPACE=
# Asynq 클라이언트 Redis 읽기/쓰기 타임아웃(밀리초, 기본값 500, 쓰기는 1000까지 늘릴 수 있음).
# WEKNORA_REDIS_OP_TIMEOUT_MS=500

# --- Redis TLS(관리형 Redis의 암호화 통신, 예: AWS ElastiCache; 기본 비활성화)---
# TLS 활성화 여부.
# REDIS_USE_TLS=false
# TLS 인증서 검증 및 SNI에 사용할 서버 이름(주소가 IP일 때 유용).
# REDIS_TLS_SERVER_NAME=
# 서버 인증서 검증을 건너뜁니다. 안전하지 않으므로 개발/자체 서명 인증서에만 사용하고 운영 환경에서는 사용하지 마세요.
# REDIS_TLS_INSECURE_SKIP_VERIFY=false

# --- Asynq worker 동시성 ---
# 각 pool은 독립적인 asynq.Server로 완전히 격리됩니다. 비워 두거나 <1이면 코드 기본값을 사용합니다. 값은 "인스턴스별 최소 보장 동시성"이며 복제본이 여러 개인 배포에서는 복제본 수에 따라 합산됩니다. 시스템 설정(asynq.*_concurrency)에서 재시작 없이 런타임 조정도 가능합니다. 형식: 변수 = 기본값 — 처리 큐 / 설명
# default + chat_attachment(문서 파싱의 주 처리 경로; 대량 가져오기에 밀리지 않도록 chat_attachment의 가중치가 더 높음)
# WEKNORA_ASYNQ_CORE_CONCURRENCY=8
# postprocess(파싱 후 지식 베이스 후처리/fan-out; 오래 걸리는 DocReader 뒤에서 대기하지 않도록 별도 풀로 분리, 낮은 지연 시간 필요)
# WEKNORA_ASYNQ_POSTPROCESS_CONCURRENCY=2
# summary / multimodal / graph / question(요약, 이미지 멀티모달, 그래프 chunk 추출, 질문 생성; LLM/VLM 부하가 크므로 provider 예산에 맞게 조정)
# WEKNORA_ASYNQ_ENRICHMENT_CONCURRENCY=12
# sync + low(데이터 소스 동기화, FAQ 가져오기, KB 복제/삭제, 일괄 재파싱, 지식 이동; 오래 걸리는 작업으로 shared 풀의 작업 차용 대상에서 제외)
# WEKNORA_ASYNQ_MAINTENANCE_CONCURRENCY=4
# 탄력적 풀. CORE/ENRICHMENT 큐의 작업을 가져올 수 있음(atomic dequeue로 안전성 보장); POSTPROCESS/MAINTENANCE는 처리하지 않음
# WEKNORA_ASYNQ_SHARED_CONCURRENCY=6
# Wiki 생성 전용 풀(LLM 의존 작업, provider 동시성 예산에 맞게 조정)
# WEKNORA_WIKI_ASYNQ_CONCURRENCY=8
# 백그라운드 작업의 모델별 동시성 상한(0/음수이면 제한 비활성화; 대화형 chat에는 이 제한이 적용되지 않음)
# WEKNORA_MODEL_MAX_CONCURRENCY=32

# ========== B3. 파일 저장소(공통)==========
# 파일 저장소 유형: local / minio / cos / tos / s3 / obs / oss / dummy.
STORAGE_TYPE=local
# 사용자가 사용할 수 있는 저장소 유형 허용 목록(쉼표로 구분, 비워 두면 모두 허용).
# STORAGE_ALLOW_LIST=local,minio,cos,tos,s3,obs,oss
# 로컬 저장소 루트 디렉터리(STORAGE_TYPE=local일 때 사용).
LOCAL_STORAGE_BASE_DIR=/data/files
# 로컬 저장소 경로 접두사(legacy 데이터 보완용, 일반적으로 비워 둠).
# LOCAL_STORAGE_PATH_PREFIX=
# 공통 파일 크기 제한(MB, 기본값 50). 지식 베이스/첨부 파일의 단일 파일 업로드, docreader gRPC 메시지, 브라우저의 지식 베이스 검증에 적용됩니다. 배포 시점 설정으로, Go/Nginx/docreader/브라우저의 네 계층이 시작할 때 한 번만 읽습니다. 실행 중 변경해도 적용되지 않으므로 변경 후 네 계층을 모두 재시작해야 합니다.
# MAX_FILE_SIZE_MB=50
# 스킬 zip 업로드 및 GitHub/ClawHub 소스 다운로드 상한(MB, 기본값 256). ppt-master 같은 스킬 패키지는 50MB를 넘을 수 있어 지식 베이스 업로드와 별도로 제한합니다. GitHub zipball은 SKILL.md 하위 트리가 아닌 전체 저장소 압축 파일 기준이므로, 저장소가 너무 크면 다운로드 단계에서 거부됩니다. 미설정 시 MAX_FILE_SIZE_MB 이상이며 512 이하입니다. Nginx는 POST /api/v1/skills/catalog와 POST /api/v1/sandbox-configs/{id}/skills에만 이 값을 허용하며, /install, PATCH 등의 하위 경로에는 MAX_FILE_SIZE_MB가 적용됩니다. 변경 후 app과 frontend를 재시작해야 합니다.
# MAX_SKILL_BUNDLE_SIZE_MB=256

# ========== B4. 객체 저장소 provider(STORAGE_TYPE에 맞게 하나 선택)==========
# ----- MinIO（STORAGE_TYPE=minio）-----
# MinIO 엔드포인트(host:port). IM 채널에서는 IM 플랫폼이 공용 인터넷에서 접근할 수 있는 host여야 합니다(minio:9000 사용 불가).
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY_ID=your_minio_access_key
# MINIO_SECRET_ACCESS_KEY=your_minio_secret_key
# MINIO_BUCKET_NAME=your_minio_bucket_name
# MINIO_PATH_PREFIX=
# MINIO_USE_SSL=false
# MinIO 포트(compose 매핑용).
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# ----- Tencent Cloud COS(STORAGE_TYPE=cos)-----
# COS_SECRET_ID=your_cos_secret_id
# COS_SECRET_KEY=your_cos_secret_key
# COS_REGION=ap-guangzhou
# COS_BUCKET_NAME=your_cos_bucket_name
# COS_APP_ID=your_cos_app_id
# COS_PATH_PREFIX=your_cos_path_prefix
# COS_TEMP_BUCKET_NAME=your_cos_temp_bucket_name
# COS_TEMP_REGION=your_cos_temp_region
# ----- Volcengine TOS(STORAGE_TYPE=tos)-----
# TOS_ENDPOINT=https://tos-cn-beijing.volces.com
# TOS_REGION=cn-beijing
# TOS_ACCESS_KEY=your_tos_access_key
# TOS_SECRET_KEY=your_tos_secret_key
# TOS_BUCKET_NAME=your_tos_bucket_name
# TOS_PATH_PREFIX=your_tos_path_prefix
# TOS_TEMP_BUCKET_NAME=your_tos_temp_bucket_name
# TOS_TEMP_REGION=your_tos_temp_region
# AWS S3를 파일 저장소로 사용하려면 다음 매개변수를 설정해야 합니다.
# AWS S3 접근 엔드포인트(선택 사항; 비워 두면 Region에 해당하는 AWS 표준 엔드포인트 사용, 예: https://s3.amazonaws.com).
# ----- AWS S3（STORAGE_TYPE=s3）-----
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# AWS S3 접근 키 Access Key(선택 사항; AK/SK를 모두 비워 두면 AWS SDK 기본 자격 증명 체인을 사용하며,
# EC2/ECS/EKS IAM Role, IRSA/Web Identity, 환경 변수 및 공유 설정 파일을 지원합니다).
# AWS S3 접근 키 Secret Key(Access Key와 함께 입력하거나 둘 다 비워 두어야 함).
# S3_SECRET_KEY=your_s3_secret_key
# S3_ACCESS_KEY=your_s3_access_key
# S3_BUCKET_NAME=your_s3_bucket_name
# S3_PATH_PREFIX=weknora/
# S3_USE_SSL=true
# S3_FORCE_PATH_STYLE=false
# ----- Huawei Cloud OBS(STORAGE_TYPE=obs)-----
# OBS_ENDPOINT=obs.cn-north-4.myhuaweicloud.com
# OBS_REGION=cn-north-4
# OBS_ACCESS_KEY=your_obs_access_key
# OBS_SECRET_KEY=your_obs_secret_key
# OBS_BUCKET_NAME=your_obs_bucket_name
# OBS_PATH_PREFIX=weknora/
# OBS_USE_SSL=true
# OBS_PROXY_DOMAIN=https://your-domain.com/obs
# ----- Alibaba Cloud OSS(STORAGE_TYPE=oss)-----
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_REGION=cn-hangzhou
# OSS_ACCESS_KEY=your_oss_access_key
# OSS_SECRET_KEY=your_oss_secret_key
# OSS_BUCKET_NAME=your_oss_bucket_name
# OSS_PATH_PREFIX=weknora/
# OSS_TEMP_BUCKET_NAME=your_oss_temp_bucket_name
# OSS_TEMP_REGION=your_oss_temp_region


# #####################################################################
# C. 검색 및 그래프
# #####################################################################

# ========== C1. 벡터 데이터베이스 / 검색 엔진 ==========
# 벡터 저장소 유형(쉼표로 구분하여 여러 드라이버 지정 가능): postgres / elasticsearch_v7 / elasticsearch_v8 /
# opensearch / qdrant / milvus / weaviate / doris / tencent_vectordb。
RETRIEVE_DRIVER=postgres
# 여러 벡터 데이터베이스의 병렬 검색 타임아웃(초, RETRIEVE_DRIVER에 여러 드라이버가 있을 때 적용).
# MULTI_STORE_RETRIEVE_TIMEOUT_SEC=
# ----- Elasticsearch v7/v8 -----
# ELASTICSEARCH_ADDR=http://localhost:9200
# ELASTICSEARCH_USERNAME=your_elasticsearch_username
# ELASTICSEARCH_PASSWORD=your_elasticsearch_password
# ELASTICSEARCH_INDEX=WeKnora
# ----- OpenSearch(dev compose에 단일 노드 profile 포함)-----
# OPENSEARCH_ADDR=http://opensearch:9200
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# OPENSEARCH_INSECURE_SKIP_VERIFY=false
# OPENSEARCH_INDEX=WeKnora
# ----- Qdrant -----
# QDRANT_HOST=qdrant
# QDRANT_PORT=6334
# QDRANT_REST_PORT=6333
# QDRANT_COLLECTION=weknora_embeddings
# QDRANT_API_KEY=your_qdrant_api_key
# QDRANT_USE_TLS=false
# ----- Milvus -----
# MILVUS_ADDRESS=milvus:19530
# MILVUS_COLLECTION=weknora_embeddings
# MILVUS_METRIC_TYPE=IP          # IP(기본값)/COSINE/L2, 변경 후 collection을 다시 생성해야 합니다.
# 새 Collection에는 content용 english/chinese/default 다국어 분석기가 설정됩니다.
# 기존 Collection은 먼저 go run ./cmd/milvus-migrate를 실행한 뒤(metric은 원본 Collection의 값 유지),
# MILVUS_COLLECTION을 대상 접두사로 변경하세요. MILVUS_METRIC_TYPE은 변경하지 마세요.
# MILVUS_USERNAME=your_milvus_username
# MILVUS_PASSWORD=your_milvus_password
# MILVUS_DB_NAME=your_milvus_db_name
# ----- Weaviate -----
# 컨테이너 내부 접근 시 service:port를 사용하세요(localhost/호스트 매핑 포트 사용 금지).
# WEAVIATE_HOST=weaviate:8080
# WEAVIATE_GRPC_ADDRESS=weaviate:50051
# WEAVIATE_SCHEME=http
# WEAVIATE_AUTH_ENABLED=false    # APIKey/OIDC 활성화 시에만 true로 설정하고 WEAVIATE_API_KEY를 지정하세요.
# WEAVIATE_API_KEY=your_secret_key
# WEAVIATE_COLLECTION=your_weaviate_db_name
# ----- Apache Doris 4.1+ -----
# DORIS_ADDR=doris-fe:9030       # FE MySQL 프로토콜 주소.
# DORIS_HTTP_PORT=8030           # FE HTTP, Stream Load partial update 진입점.
# DORIS_DATABASE=weknora
# DORIS_USERNAME=root
# DORIS_PASSWORD=
# DORIS_TABLE_PREFIX=weknora_embeddings
# DORIS_COMPAT_MODE=auto         # auto(자동 감지)/legacy(cosine_distance)/inner_product_duplicate; 테이블 생성 후에는 모드 간 전환 불가.
# compose 포트.
# DORIS_FE_HTTP_PORT=8030
# DORIS_FE_MYSQL_PORT=9030
# DORIS_BE_HTTP_PORT=8040
# ----- Tencent Cloud Tencent VectorDB -----
# TENCENT_VECTORDB_ADDR=http://your-instance.tencentvectordb.com
# TENCENT_VECTORDB_USERNAME=root
# TENCENT_VECTORDB_API_KEY=your_tencent_vectordb_api_key
# TENCENT_VECTORDB_DATABASE=weknora
# TENCENT_VECTORDB_COLLECTION=weknora_embeddings
# TENCENT_VECTORDB_REPLICA_NUMBER=1

# ========== C2. 지식 그래프(Neo4j, 선택 사항)==========
# 지식 그래프의 유일한 전역 스위치. true가 아니면 그래프 구축 및 검색이 비활성화됩니다(구축 단계에서 대형 언어 모델을 호출하므로 시간이 오래 걸림).
# 참고: ENABLE_GRAPH_RAG는 v0.1.6부터 NEO4J_ENABLE로 대체되었습니다. Go 주 애플리케이션에서 더 이상 읽지 않으며 제거되었습니다.
# NEO4J_ENABLE=false
# Neo4j 연결 URI. bolt://는 단일 노드에 직접 연결(권장, 라우팅 오버헤드 없음), neo4j://는 클러스터 라우팅 검색 사용(단일 노드에서도 사용 가능하지만 탐색 1회 추가).
# WeKnora는 기본적으로 단일 노드 Neo4j를 배포하므로 bolt://를 사용합니다.
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password


# #####################################################################
# D. 모델
# #####################################################################

# ========== D1. LLM / VLM / Ollama ==========
# Ollama를 사용할 수 없어도 경고만 표시하고 실행을 중단하지 않습니다(true일 때 적용, Ollama 미설정으로 인한 시작 실패를 방지하도록 기본적으로 중단하지 않음).
OLLAMA_OPTIONAL=true
# 로컬 Ollama의 단일 주소. source=local인 임베딩 모델과 대화 모델이 이 프로세스를 공유하므로
# embedding용 Ollama를 별도로 실행할 필요가 없습니다. 미설정 시 http://localhost:11434를 사용합니다.
# 임베딩 모델 이름은 환경 변수가 아닙니다. "설정 → 모델", CLI 또는 초기화 API에서 Embedding
# 모델의 name을 Ollama 모델 이름(예: nomic-embed-text)으로 설정하세요. README의 Ollama 설명을 참조하세요.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# embedding 배치 크기(비워 두면 코드 기본값 사용).
# BATCH_EMBED_SIZE=
# 지식 베이스 설명 생성에 사용할 completion token 예산(비워 두면 코드 기본값 2048 사용). 추론 모델은 사고 기능을 꺼도
# 적은 예산을 소진하여 설명 생성에 실패할 수 있습니다(no gist 오류). 이런 경우 이 값을 늘릴 수 있습니다.
# KNOWLEDGE_BASE_PROFILE_MAX_TOKENS=
# VLM 단일 HTTP 요청 타임아웃(초, 기본값 180; 느린 엔드포인트에서 context deadline 타임아웃이 발생하면 늘리세요).
# VLM_HTTP_TIMEOUT_SECONDS=180
# LLM 스트림 원시 덤프(컨텍스트 문제 진단용; 1로 활성화, 기본 디렉터리 ~/.weknora/investigate/llm-stream).
# WEKNORA_LLM_STREAM_RAW_DUMP=
# WEKNORA_LLM_STREAM_RAW_DUMP_DIR=

# ========== D2. 내장 모델 선언형 설정(선택 사항)==========
# config/builtin_models.yaml(config/builtin_models.yaml.example 참조)을 활성화하면 YAML의
# ${NAME} 플레이스홀더에 사용할 실제 값을 애플리케이션 시작 시 이곳에서 읽습니다. 변수 이름은 YAML에서 지정하며, 아래는 일반적인 이름 예시입니다.
# 자세한 내용은 website-docs/03-features/06-models.md를 참조하세요.
#
# 내장 대화 모델
# LLM_MODEL_NAME=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_PROVIDER=openai
#
# 내장 임베딩 모델. 아래 이름은 builtin_models.yaml의 ${...}에 지정된 경우에만 읽습니다.
# 로컬 Ollama 임베딩 모델은 source: local, name은 ${EMBEDDING_MODEL_NAME}(Ollama 모델 이름)을 사용합니다.
# 주소는 위의 OLLAMA_BASE_URL을 그대로 사용합니다. EMBEDDING_BASE_URL은 source: remote인 API에만 사용됩니다.
# 예시는 config/builtin_models.yaml.example의 “one local Ollama” 항목을 참조하세요.
# EMBEDDING_MODEL_NAME=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_PROVIDER=openai
#
# 내장 Rerank 모델
# RERANK_MODEL_NAME=
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_PROVIDER=generic


# #####################################################################
# E. 문서 파싱
# #####################################################################

# ========== E1. Docreader gRPC 및 파싱 공통 설정 ==========
# ----- gRPC 서버 TLS / 인증(docreader와 app이 공유하며 클라이언트/서버에 같은 값 설정 필요)-----
# gRPC TLS 암호화 통신을 활성화합니다. 기본값 false(docreader는 compose 내부망에서 app에만 제공되므로 평문 통신으로 충분).
# GRPC_TLS_ENABLED=false
# 서버 인증서 / 클라이언트 인증서(mTLS 사용 시 입력). server에서 TLS 활성화 시 필수입니다.
# GRPC_TLS_CERT=/path/to/server.crt
# 인증서에 해당하는 개인 키.
# GRPC_TLS_KEY=/path/to/server.key
# CA 인증서: client에서는 server 인증서 검증용, server에서 mTLS 사용 시에는 클라이언트 인증서 발급 CA용.
# GRPC_TLS_CA=/path/to/ca.crt
# TLS SNI / 인증서 검증 이름. DOCREADER_ADDR가 IP이거나 인증서 CN과 다르면 인증서의 hostname으로 설정하세요.
# GRPC_TLS_SERVER_NAME=
# server 측: true이면 클라이언트 인증서를 필수로 요구합니다(상호 TLS / mTLS).
# GRPC_MTLS_REQUIRE_CLIENT_CERT=false
# gRPC per-RPC 인증 token(클라이언트/서버가 같아야 함). 활성화 시 TLS도 함께 켜는 것을 강력히 권장합니다.
# 그렇지 않으면 token이 매 RPC마다 평문으로 전송됩니다. GRPC_TLS_ENABLED=true이면 클라이언트는 안전하지 않은 연결로 token을 보내지 않습니다.
# GRPC_AUTH_TOKEN=your-secret-token-at-least-16-bytes
# ----- gRPC 서비스 매개변수 -----
# gRPC server의 최대 동시 worker 수(기본값 4).
# DOCREADER_GRPC_MAX_WORKERS=4
# gRPC 단일 메시지 크기 상한(MB, 기본값 50). 일반적으로 MAX_FILE_SIZE_MB에 맞추며, 매우 큰 스캔 이미지는 이 값을 초과할 수 있습니다.
# DOCREADER_GRPC_MAX_FILE_SIZE_MB=50
# gRPC 수신 포트(기본값 50051)는 보통 변경할 필요가 없으며, docker-compose의 docreader port와 일치해야 합니다.
# DOCREADER_GRPC_PORT=50051
# ----- 파싱 공통 설정 -----
# DOCX 파싱 최대 페이지 수(기본값 0=제한 없음). 양의 정수(예: 500)로 설정하면 매우 큰 Word 문서의 파싱 비용을 제한할 수 있습니다.
# DOCREADER_DOCX_MAX_PAGES=0
# MarkItDown(고부하 파서)의 동시 worker 수. 0이면 제한을 해제하며, 기본값 1은 단일 머신/GPU 자원이 제한된 환경에 적합합니다.
# DOCREADER_MARKITDOWN_MAX_WORKERS=1
# 아웃바운드 HTTP/HTTPS 프록시(웹 페이지 / 원격 이미지 가져오기용).
# DOCREADER_EXTERNAL_HTTP_PROXY=
# DOCREADER_EXTERNAL_HTTPS_PROXY=

# ========== E2. OpenDataLoader hybrid(선택 사항, 지식 베이스 parser_engine_rules에 engine: opendataloader 지정)==========
# ODL 고부하 파서 동시성(기본값 1).
# DOCREADER_ODL_MAX_WORKERS=1
# hybrid 모드 스위치: off(기본값, fast 로컬 파싱만 사용) / docling-fast 등(별도 odl-hybrid 컨테이너 필요).
# DOCREADER_ODL_HYBRID=off
# odl-hybrid 서비스 주소. 코드 기본값은 http://127.0.0.1:5002이며, docker compose는 http://odl-hybrid:5002를 주입합니다.
# DOCREADER_ODL_HYBRID_URL=http://odl-hybrid:5002
# hybrid 모드 선택(auto). 일반적으로 변경할 필요가 없습니다.
# DOCREADER_ODL_HYBRID_MODE=auto
# hybrid 실패 시 fast 모드로 대체할지 여부(기본값 false).
# DOCREADER_ODL_HYBRID_FALLBACK=false
# hybrid가 출력하는 markdown에 HTML을 유지할지 여부(기본값 false).
# DOCREADER_ODL_MARKDOWN_WITH_HTML=false
# ----- odl-hybrid 컨테이너 매개변수(--profile odl-hybrid 사용 시에만 적용)-----
# odl-hybrid에 전달할 추가 인수. 기본값 --no-ocr(디지털 PDF); 스캔 문서는 --force-ocr 사용(EasyOCR+libGL 필요).
# ODL_HYBRID_EXTRA_ARGS=--no-ocr
# odl-hybrid 외부 포트(dev compose 매핑용).
# ODL_HYBRID_PORT=5002
# app 시작 시 odl-hybrid 준비 완료를 기다리는 최대 시간(초).
# ODL_HYBRID_STARTUP_WAIT_SEC=180

# ========== E3. PDF 렌더링 ==========
# PDF 렌더링 worker 수(문서 간 동시성, 기본값 1).
# DOCREADER_PDF_RENDER_MAX_WORKERS=1
# 단일 PDF 내부의 "스캔 페이지 렌더링" 병렬 프로세스 수(pdfium은 스레드 안전하지 않으므로 프로세스 단위로 병렬 처리). 기본값은 CPU 수에 따라 min(4, cpu)입니다. 대용량 스캔 문서를 CPU가 제한된 컨테이너에서 순차 렌더링하면 몇 시간이 걸릴 수 있으며, 이 값을 높이면 크게 단축됩니다(실측 874페이지 117s->30s/4프로세스 ->17s/8프로세스). 속도 향상을 얻으려면 컨테이너에 충분한 CPU를 할당해야 합니다.
# DOCREADER_PDF_RENDER_PARALLELISM=4
# 렌더링 DPI(기본값 200).
# DOCREADER_PDF_RENDER_DPI=200
# 렌더링 이미지의 JPEG 품질(기본값 85).
# DOCREADER_PDF_JPEG_QUALITY=85
# 렌더링 페이지 이미지의 긴 변 최대 픽셀 수(기본값 2000). 초대형 페이지가 100+MP 이미지로 렌더링되어 gRPC 메시지 상한을 초과하지 않도록 합니다. 값을 낮추면 이미지 크기가 더 줄지만, 너무 낮으면 OCR 정확도에 영향을 줍니다(중국어가 빽빽한 문서는 >=1600 권장).
# DOCREADER_PDF_RENDER_MAX_EDGE=2000

# ========== E4. PDF 스캔 문서 판정 및 강제 적용 ==========
# 모든 PDF의 모든 페이지를 스캔 문서로 강제 파싱합니다(이미지로 렌더링 후 OCR/VLM 처리). 텍스트 레이어의 품질이 낮지만 페이지에 OCR을 적용할 수 있는 PDF에 적합합니다. 활성화하면 처리 시간과 모델 호출 비용이 모두 증가합니다. 기본값 false(아래 임계값으로 자동 판정).
# DOCREADER_PDF_FORCE_SCANNED=false
# 자동 판정: 페이지 내 이미지 객체의 면적 점유율이 이 비율 이상이면 스캔 페이지로 간주합니다(기본값 0.5).
# DOCREADER_PDF_SCAN_IMAGE_RATIO=0.5
# 자동 판정: 페이지의 텍스트 문자 수가 이 값보다 적으면 "사용 가능한 텍스트 레이어 없음"으로 간주합니다(기본값 10).
# DOCREADER_PDF_SCAN_MIN_CHARS=10

# ========== E5. PDF 레이아웃 / 텍스트 추출(기본 텍스트 페이지)==========
# 레이아웃 인식 텍스트 추출: 읽기 좋은 순서로 재구성합니다(기본값 true).
# DOCREADER_PDF_LAYOUT_ORDERING=true
# glyph에 명시적 공백 위치 정보가 없을 때(OCR/검색용 텍스트에서 흔함), 간격이 median 문자 폭의 몇 배를 넘으면 공백을 삽입할지 지정합니다(기본값 0.4).
# DOCREADER_PDF_WORD_GAP_WIDTH_RATIO=0.4
# 좁은 사이드바(arXiv 측면 워터마크, 페이지 번호 레이블)를 버리는 페이지 너비 비율 임계값(기본값 0.12).
# DOCREADER_PDF_MARGIN_COL_WIDTH_RATIO=0.12
# 글꼴 크기 휴리스틱으로 markdown 제목으로 승격할 수 있는 줄의 최소 문자 수(기본값 8).
# DOCREADER_PDF_MIN_HEADING_LINE_CHARS=8
# 시각적으로 큰 줄을 markdown 제목으로 승격합니다(rect 높이를 글꼴 크기의 대용 지표로 사용, 기본값 true).
# DOCREADER_PDF_DETECT_HEADINGS=true
# hidden-text 주입을 방지하기 위해 보이지 않는 텍스트(render-mode 3), 페이지 밖 텍스트, 퇴화된 텍스트를 버립니다(기본값 true).
# DOCREADER_PDF_FILTER_HIDDEN_TEXT=true
# pdfium 플레이스홀더(U+FFFE)와 소프트 하이픈을 정리하고, 벡터 그래픽의 축/범례 텍스트를 제거합니다(기본값 true).
# DOCREADER_PDF_SANITIZE_TEXT=true
# 차트 영역의 조각난 텍스트를 제거합니다(SANITIZE_TEXT와 함께 사용, 기본값 true).
# DOCREADER_PDF_STRIP_CHART_DEBRIS=true

# ========== E6. PDF 내장 이미지 추출(기본 텍스트 페이지)==========
# 기본 페이지의 내장 비트맵을 추출하여 VLM/OCR 분석에 사용합니다(기본값 true).
# DOCREADER_PDF_EXTRACT_EMBEDDED_IMAGES=true
# 유지할 내장 이미지의 최소 픽셀 너비와 높이(기본값 80, 미만이면 버림).
# DOCREADER_PDF_EMBED_MIN_PIXELS=80
# 내장 이미지가 페이지 면적에서 차지해야 하는 최소 비율. 미만이면 버립니다(기본값 0.01).
# DOCREADER_PDF_EMBED_MIN_AREA_RATIO=0.01
# 같은 이미지가 텍스트 페이지에 나타나는 비율이 이 값 이상이면 머리글/바닥글 등의 반복 요소로 간주하여 중복 제거합니다(기본값 0.5).
# DOCREADER_PDF_EMBED_REPEAT_PAGE_FRAC=0.5
# 문서당 내장 이미지 추출의 절대 상한(기본값 50).
# DOCREADER_PDF_EMBED_MAX_IMAGES=50

# ========== E7. PDF 차트 영역 인식(벡터 그래픽 영역)==========
# 감지된 벡터 차트 영역(내장 비트맵 없음)을 JPEG로 렌더링하여 VLM/OCR에 제공합니다(기본값 true).
# DOCREADER_PDF_RENDER_VECTOR_FIGURES=true
# 영역을 차트로 간주하기 위한 줄당 최소 문자 수(기본값 18).
# DOCREADER_PDF_MIN_CHART_REGION_CHARS=18
# 영역을 차트로 간주하기 위한 최소 면적 비율(기본값 0.015).
# DOCREADER_PDF_MIN_CHART_REGION_AREA=0.015
# 영역을 차트로 간주하는 최대 면적 비율(초과하면 차트로 간주하지 않음, 기본값 0.42).
# DOCREADER_PDF_MAX_CHART_REGION_AREA=0.42
# 페이지 높이에 대한 그림 높이의 최대 비율. 초과하면 독립 차트로 간주하지 않습니다(기본값 0.38).
# DOCREADER_PDF_MAX_FIGURE_HEIGHT_RATIO=0.38

# ========== E8. 문서 처리 / 작업 타임아웃 ==========
# 단일 문서 처리 작업의 전체 타임아웃(Go duration, 기본값 2h; 큰 파일은 늘릴 수 있음).
# WEKNORA_DOCUMENT_PROCESS_TIMEOUT=2h
# 단일 DocReader RPC 타임아웃(기본값 30m, 위 항목보다 작아야 함).
# WEKNORA_DOCREADER_CALL_TIMEOUT=30m
# 자체 호스팅 PaddleOCR-VL HTTP 요청 타임아웃(양수 Go duration, 기본값 1000s; 유효하지 않은 값은 기본값 사용).
# 큰 파일 예시: 이 항목 90m, DocReader 100m, 단일 문서 작업 2h. 바깥쪽 타임아웃에는 여유를 두어야 합니다.
# WEKNORA_PADDLEOCR_VL_TIMEOUT=1000s
# 자체 호스팅 MinerU 단일 파싱 타임아웃(양수 Go duration, 기본값 1000s; 유효하지 않은 값은 기본값 사용).
# 초대형 PDF도 바깥쪽 타임아웃에 여유가 필요합니다. 예: 이 항목 90m, DocReader 100m, 단일 문서 작업 2h.
# WEKNORA_MINERU_TIMEOUT=1000s
# MinerU 클라우드(mineru.net)에서 파싱 결과를 폴링하는 최대 시간(양수 Go duration, 기본값 600s).
# WEKNORA_MINERU_CLOUD_TIMEOUT=600s
# PaddleOCR-VL 클라우드(AI Studio)에서 파싱 결과를 폴링하는 최대 시간(양수 Go duration, 기본값 600s).
# WEKNORA_PADDLEOCR_VL_CLOUD_TIMEOUT=600s
# WeKnoraCloud 관리형 docreader에서 작업 결과를 폴링하는 최대 시간(양수 Go duration, 기본값 20m; WEKNORA_DOCREADER_CALL_TIMEOUT보다 작아야 함).
# WEKNORA_WEKNORACLOUD_TIMEOUT=20m
# 지식 베이스 정기 점검 및 정리(processing에 멈춘 더티 데이터 회수; false로 비활성화, 권장하지 않음).
# WEKNORA_HOUSEKEEPING_ENABLED=true
# 채팅 첨부 파일의 파싱 결과 보관 시간(시간, 기본값 24).
# WEKNORA_CHAT_ATTACHMENT_TTL_HOURS=24
# 단일 질의응답에서 첨부 파일 파싱 완료를 기다리는 최대 시간(초, 기본값 60; 대용량/스캔 문서는 늘리세요).
# WEKNORA_CHAT_ATTACHMENT_WAIT_TIMEOUT_SEC=60
# 첨부 파일 VLM OCR 튜닝(스캔/이미지형 문서): 동시성 / 최대 페이지 수.
# WEKNORA_CHAT_ATTACHMENT_OCR_CONCURRENCY=8
# WEKNORA_CHAT_ATTACHMENT_OCR_MAX_PAGES=8

# ========== E9. Feishu 클라우드 문서 파싱 모드 ==========
# Feishu 드라이브 / Feishu 지식 베이스에서 새 형식의 클라우드 문서(docx)를 동기화할 때 파싱 경로를 제어합니다.
#   export(기본값, 비워 두어도 됨): 비동기 내보내기 API로 .docx 바이너리를 다운로드하여 docreader로
#     파싱합니다. 이미지는 상위 문서에 inline으로 포함됩니다(parent_chunk_id로 knowledge와 연결). 검색 /
#     wiki / 에이전트 세 시나리오 모두에서 이미지 내용을 연결할 수 있습니다. 단점: 동기화가 느려집니다. Feishu docx 내의
#     file block 첨부 파일은 내보내기 시 함께 다운로드되지 않습니다(누락되므로 별도 동기화 필요). 클라우드 문서에 스프레드시트,
#     다차원 테이블 등이 있으면 내보내기 후 docx에 내장된 표로 바뀌며, weknora는 이러한 표를 파싱할 수 없습니다.
#   blocks: blocks API로 Markdown으로 변환합니다. 빠르고 docx 내 첨부 파일을 유지하지만, 이미지는 빈
#     `![이미지]()` 플레이스홀더로 렌더링되고 독립 지식 항목으로 저장되어 상위 문서와 내용이 연결되지 않습니다(검색 /
#     wiki / 에이전트 모두 이미지를 문서에 다시 연결할 수 없음). 스프레드시트는 markdown 표로 파싱되며,
#     병합된 셀 등의 서식이 손실될 수 있습니다.
# 이미지 연결이 필요 없고 속도가 중요하거나, 첨부 파일 또는 스프레드시트 서식을 유지해야 할 때 blocks로 설정하세요.
# 임시 방안이며, 향후 더 나은 파싱 방법이 나오면 이 환경 변수를 제거하고 대체할 예정입니다.
# FEISHU_DOCX_PARSE_MODE=export

# Feishu 내보내기 생성 / 조회 / 다운로드 및 Wiki 하위 노드 목록은 각각 애플리케이션별 할당량을 공유합니다(단일 프로세스).
# 기본값은 API별 분당 80회이며, 버스트 할당량을 누적하지 않고 균등하게 전송합니다. 양의 정수로 기본값을 재정의할 수 있습니다.
# FEISHU_API_REQUESTS_PER_MINUTE=80
# 요청 제한 응답에 유효한 대기 안내가 없을 때의 대기 시간(Go duration, 기본값 10s).
# FEISHU_RATE_LIMIT_RETRY_WAIT=10s
# 각 공유 대기 구간의 최대 대기 시간. 응답 헤더의 안내와 위 기본 대기 시간을 포함합니다(Go duration).
# FEISHU_RATE_LIMIT_MAX_WAIT=5m
# 내보내기 작업의 최대 폴링 횟수. 요청 제한 재시도 및 대기는 폴링 횟수에 포함되지 않으며, 작업 컨텍스트는 계속 취소할 수 있습니다.
# FEISHU_EXPORT_MAX_POLLS=30
# 내보내기 작업의 폴링 간격(Go duration).
# FEISHU_EXPORT_POLL_INTERVAL=2s

# #####################################################################
# F. 인증 및 공간 격리
# #####################################################################

# ========== F1. 키 ⚠️ 필수(운영 환경에서는 반드시 기본값 변경)==========
# JWT 서명 키. 프런트엔드 로그인 갱신 Token에 사용합니다(비워 두면 시작 시 무작위 생성).
# Generate once: openssl rand -hex 32
JWT_SECRET=
# AES-256 마스터 키. 데이터베이스의 API Key 등 민감한 필드를 저장할 때 암호화하는 데 사용합니다(반드시 32바이트).
# 암호화 대상: tenants.api_key, 모델 API key, 벡터 데이터베이스 자격 증명, web search provider key,
# WeKnoraCloud.AppSecret 등. 키가 없거나 길이가 잘못되면 암호화된 필드를 복호화할 수 없습니다(UI에는 빈 값으로 표시되며 다시 입력해야 함).
# 운영 환경에서는 반드시 명시적으로 설정하고 안전하게 보관하세요. 분실하면 모든 암호화 데이터를 복구할 수 없습니다.
# 참고: TENANT_AES_KEY / CRYPTO_MASTER_KEY / CRYPTO_SALT는 폐기되었습니다. v0.4.0부터 CryptoService(PBKDF2)가 제거되고 암호화는 SYSTEM_AES_KEY로 통일되었습니다. 이 세 변수는 Go 주 애플리케이션에서 더 이상 읽지 않으며 제거되었습니다.
# Generate once: openssl rand -hex 16 (32 ASCII bytes); retain existing keys on upgrade.
SYSTEM_AES_KEY=
# Optional independent signing key for embed sessions and presigned URLs.
# Generate once: openssl rand -hex 32. Falls back to a valid SYSTEM_AES_KEY.
SYSTEM_SIGNING_KEY=

# ========== F2. 회원가입 및 공간 정책 ==========
# 신규 사용자 회원가입을 금지합니다(운영 환경에서는 true 권장).
# DISABLE_REGISTRATION=false
# 활성화하면 비밀번호에 대문자, 소문자, 숫자, 특수 문자가 모두 포함되어야 합니다. 특수 문자: !@#$%^&*()_+-=[]{}|;:,.<>?
# WEKNORA_AUTH_COMPLEX_PASSWORD_ENABLED=false
# 공개 회원가입 후 기본 공간 정책: create_personal(기본값, 개인 공간 자동 생성) / tenantless.
# WEKNORA_AUTH_DEFAULT_TENANT_MODE=create_personal
# 일반 사용자가 로그인 후 직접 공간을 생성할 수 있는지 여부(기본값 true; false이면 초대로만 참여 가능하며 최고 관리자에게는 적용되지 않음).
# WEKNORA_TENANT_SELF_SERVICE_CREATION_ENABLED=true
# 공간 단위 RBAC 활성화(true: 기본값, 권한 검사 강제 적용 / false: 관찰 모드, 공간 내 역할 검사 결과만 기록하고 차단하지 않음; 공간 간 접근은 항상 차단).
# WEKNORA_TENANT_ENABLE_RBAC=true
# 공간 간 접근 활성화(사용자의 CanAccessAllTenants 권한과 함께 사용 필요; 기본값 false). 공간 간 관리자가 필요하면 데이터베이스를 직접 수정하여 해당 사용자에게 공간 간 관리 권한을 부여해야 합니다.
# WEKNORA_TENANT_ENABLE_CROSS_TENANT_ACCESS=false
# 최고 관리자가 아닌 사용자 1명이 직접 생성할 수 있는 공간 수 상한(>0 제한 적용; =0 기본값 사용; <0 제한 해제).
# WEKNORA_TENANT_MAX_OWNED_PER_USER=
# 공간 생성 시 full_access API Key를 자동 생성하고 응답에 token을 반환할지 여부(기본값 false, 이전 버전 호환 동작으로 되돌리는 스위치).
# WEKNORA_TENANT_AUTO_CREATE_API_KEY=false
# 새 공간의 기본 저장소 할당량(GB, 기본값 10).
# WEKNORA_TENANT_DEFAULT_STORAGE_QUOTA_GB=10
# 공간 초대 링크 TTL(Go duration, 기본값 168h=7일).
# WEKNORA_INVITATION_TTL=168h
# 전역 스위치: 이미 가입한 사용자를 초대하면 공간에 바로 추가합니다. 기본값 false이며 시스템 설정 페이지에서 변경할 수 있습니다.
# WEKNORA_TENANT_AUTO_ACCEPT_INVITATION=false
# 감사 로그 보관 일수(0이면 정리 비활성화, 기본값 90).
# WEKNORA_AUDIT_RETENTION_DAYS=90

# ========== F3. OIDC 인증(선택 사항, OIDC_AUTH_ENABLE=true로 활성화)==========
# OIDC_AUTH_ENABLE=false
# OIDC_AUTH_ISSUER_URL=http://127.0.0.1:5556/dex
# OIDC_AUTH_DISCOVERY_URL=http://127.0.0.1:5556/dex/.well-known/openid-configuration
# OIDC_AUTH_PROVIDER_DISPLAY_NAME=OIDC
# OIDC_AUTH_CLIENT_ID=client_id_for_oidc_client
# OIDC_AUTH_CLIENT_SECRET=secret_for_oidc_client
# OIDC_AUTH_DISCOVERY_URL이 설정되어 있으면 아래 엔드포인트는 비워 둘 수 있습니다. 인증/Token 엔드포인트를 명시적으로 입력했더라도,
# jwks_uri 또는 issuer가 비어 있으면 discovery로 보완하여 id_token 검증에 사용합니다.
# OIDC_AUTH_AUTHORIZATION_ENDPOINT=http://127.0.0.1:5556/dex/auth
# OIDC_AUTH_TOKEN_ENDPOINT=http://127.0.0.1:5556/dex/token
# OIDC_AUTH_USER_INFO_ENDPOINT=http://127.0.0.1:5556/dex/userinfo
# OIDC_AUTH_JWKS_URI=http://127.0.0.1:5556/dex/keys
# OIDC_AUTH_SCOPES="openid profile email"
# OIDC 최초 자동 계정 생성 후 공간 정책은 로컬 회원가입과 WEKNORA_AUTH_DEFAULT_TENANT_MODE를 공유하며 별도 설정은 없습니다.
# OIDC_USER_INFO_MAPPING_USER_NAME=name
# OIDC_USER_INFO_MAPPING_EMAIL=email


# #####################################################################
# G. Agent 및 샌드박스
# #####################################################################

# ========== G1. Agent Skills Sandbox ==========
# Sandbox 백엔드, 자격 증명, 템플릿, 타임아웃, 사설망 접근 정책은 모두 "설정 → 샌드박스 백엔드"에서
# 공간별로 관리합니다. 배포 수준의 유일한 스위치는 Docker 백엔드입니다. 로컬
# docker.sock 접근은 호스트 root 권한과 같으므로 기본적으로 비활성화됩니다. 자체 호스팅 단일 머신에서 필요하면 true로 바꾸거나, 시스템 관리자가
# "설정 → 시스템 설정 → 네트워크 보안"에서 활성화할 수 있습니다(재시작 없이 즉시 적용).
WEKNORA_SANDBOX_DOCKER_ENABLED=false
# 여러 인스턴스에서는 session→sandbox binding을 공유하도록 공통 REDIS_ADDR를 설정해야 합니다.

# 에이전트 대형 언어 모델 호출의 기본 타임아웃(초, 기본값 120; 복잡한 추론은 300/600 등으로 늘리세요).
# 참고: 전역 기본값이며, 개별 에이전트에 데이터베이스의 llm_call_timeout이 별도로 설정되어 있으면 그 값을 우선합니다.
# WEKNORA_AGENT_LLM_TIMEOUT=300
# MCP 도구의 수동 검토 대기 타임아웃(초, 기본값 600; 30s/5m/1h 등의 Go duration도 지원).
# WEKNORA_AGENT_TOOL_APPROVAL_TIMEOUT=600
# MCP 도구의 수동 승인 실패 시 허용할지 여부(true: 허용 / 기본값 fail-close: 거부).
# WEKNORA_AGENT_TOOL_APPROVAL_FAIL_OPEN=


# #####################################################################
# H. 선택적 연동
# #####################################################################

# ========== H1. 웹 검색(SearXNG / Tavily)==========
# ===== SearXNG(선택적 자체 호스팅 웹 검색)=====
# 활성화: `docker compose --profile searxng up -d`.
# SEARXNG_SECRET이 미설정이면 docker-compose에 하드코딩된 기본값을 사용하며, 로컬/loopback 배포에는 충분합니다.
# SEARXNG_BIND=0.0.0.0으로 바꾸어 인스턴스를 LAN/공용 인터넷에 노출할 경우, 반드시 openssl rand -hex 32로 생성한 값을
# SEARXNG_SECRET에 명시적으로 설정하세요. 그렇지 않으면 누구나 기본값으로 image-proxy URL에 서명할 수 있습니다.
#
# 백엔드 접근 방법(컨테이너 배포): 콘솔에서 Provider 유형으로 "SearXNG"를 선택하고,
# Instance URL에 http://searxng:8080을 입력하세요. docker compose가 기본적으로 searxng 호스트 이름을
# SSRF_WHITELIST_EXTRA에 주입하므로 추가 설정은 필요하지 않습니다.
#
# 로컬 개발(go run + docker compose -f docker-compose.dev.yml --profile searxng up):
# 백엔드가 호스트에서 실행되므로 published 포트를 사용해야 합니다. Instance URL에 http://127.0.0.1:8888을 입력하고,
# 아래 SSRF_WHITELIST에 127.0.0.1을 추가하세요.
#
# limiter:false인 인스턴스가 LAN에 노출되지 않도록 기본적으로 포트는 127.0.0.1에서만 수신합니다.
# 내부망에 공개하려면 SEARXNG_BIND=0.0.0.0으로 명시적으로 재정의하고 직접 보안을 강화하세요.
# SEARXNG_PORT=8888
# Do not set SEARXNG_PORT to the same value as APP_PORT (default 8080).
# On Linux, binding SearXNG to 127.0.0.1:8080 while the app also publishes
# :8080 makes localhost:8080 hit SearXNG first — POST /api/v1/auth/login
# then returns SearXNG's HTML 404 even though DISABLE_REGISTRATION only
# closes registration (see discussion on issue #3296). Keep SearXNG on 8888
# (or another free port).
# SEARXNG_BIND=127.0.0.1
# SEARXNG_SECRET=
# Tavily Search API Key(선택 사항, Tavily 웹 검색 제공자 활성화).
# TAVILY_API_KEY=tvly-your_tavily_api_key

# ========== H2. MCP Server(선택 사항, --profile full 사용 시 시작)==========
# MCP Server가 WeKnora REST API에 접근할 때 사용할 API Key(프런트엔드의 "설정 -> API Keys"에서 생성).
# WEKNORA_API_KEY=
# HTTP/SSE 전송 시 필수: mcp-server 시작 시 이 항목이 없으면 시작을 거부합니다(클라이언트는 Authorization: Bearer로 전달).
# MCP_SERVER_AUTH_TOKEN=
# WeKnora REST 호출의 읽기 타임아웃(초, 기본값 300).
# WEKNORA_CHAT_TIMEOUT=300
# WeKnora 백엔드 TLS 인증서 검증 여부(기본값 true; 자체 서명 인증서이면 false로 설정 가능).
# WEKNORA_VERIFY_SSL=true
# 업로드 허용 디렉터리 목록(쉼표로 구분; 비워 두면 파일 업로드 도구 비활성화).
# MCP_ALLOWED_UPLOAD_DIRS=


# #####################################################################
# I. 관측 가능성(Langfuse, 선택 사항)
# #####################################################################

# ========== I1. Langfuse 연동(chat/embedding/rerank/VLM/ASR 모델 호출 추적 및 token 사용량 집계)==========
# 자세한 설명: website-docs/03-features/16-observability.md
#
# 방법 A: Langfuse Cloud 연동(가장 간단)
#   1) https://cloud.langfuse.com에 로그인하여 API Key 생성
#   2) 아래 PUBLIC_KEY / SECRET_KEY 입력
#   3) docker compose up -d app
#
# 방법 B: Langfuse 자체 호스팅(LAN/내부망 환경)
#   1) 자체 호스팅 스택 시작: docker compose --profile langfuse up -d
#      최초 시작 후 ClickHouse 마이그레이션에 약 1-2분이 걸리므로 langfuse-web이 정상 상태가 될 때까지 기다리세요.
#   2) 브라우저에서 http://localhost:3000을 열어 관리자 계정을 등록하고 API Key 생성
#   3) 아래 LANGFUSE_HOST=http://langfuse-web:3000의 주석을 해제하고, 방금 생성한 PUBLIC_KEY / SECRET_KEY 입력
#   4) docker compose up -d app
#
# PUBLIC_KEY + SECRET_KEY를 모두 설정하면 별도 스위치 없이 자동으로 활성화됩니다.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=http://langfuse-web:3000
# 자체 호스팅 모드에서는 다음으로 변경: LANGFUSE_HOST=http://langfuse-web:3000
# 선택 사항: 명시적 스위치(true/false, 기본적으로 key에 따라 자동 판단).
# LANGFUSE_ENABLED=true
# 선택 사항: Langfuse UI에서 필터링하기 위한 버전 / 환경 태그.
# LANGFUSE_RELEASE=v0.4.2
# LANGFUSE_ENVIRONMENT=production
# 선택 사항: 일괄 전송 및 샘플링 정책(트래픽이 많은 운영 환경에서는 FLUSH_AT을 늘리고 SAMPLE_RATE를 낮추는 것을 권장).
# LANGFUSE_FLUSH_AT=15
# LANGFUSE_FLUSH_INTERVAL=3s
# LANGFUSE_QUEUE_SIZE=2048
# LANGFUSE_REQUEST_TIMEOUT=10s
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_DEBUG=false

# ========== I2. Langfuse 자체 호스팅 스택 설정(--profile langfuse 사용 시에만 필요)==========
# 설계 설명: 리소스 사용을 최소화하기 위해 Langfuse 자체 호스팅 스택은 WeKnora의 기존 리소스를 **재사용**합니다.
#   - postgres: 별도의 "langfuse" 데이터베이스 생성(langfuse-db-init 컨테이너가 한 번 생성)
#   - redis   : 별도의 Redis DB 번호 사용(기본값 1, WeKnora는 0 사용)
# 실제로 추가되는 상시 실행 컨테이너는 3개뿐입니다: langfuse-web, langfuse-worker, langfuse-clickhouse
#                         + 전용 S3 1개: langfuse-minio
#                         + 일회성 init 1개: langfuse-db-init
# Langfuse Web UI 외부 포트.
# LANGFUSE_WEB_PORT=3000
# Langfuse 전용 MinIO 포트(WeKnora 주 MinIO의 9000/9001과 충돌 방지).
# LANGFUSE_MINIO_S3_PORT=9100
# LANGFUSE_MINIO_CONSOLE_PORT=9101
# 미디어 업로드 외부 endpoint(브라우저가 Langfuse MinIO에 직접 연결). 기본적으로 호스트에 매핑된 9100 포트를 가리킵니다.
# LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9100
# WeKnora-postgres에 생성할 Langfuse 데이터베이스 이름.
# LANGFUSE_DB_NAME=langfuse
# WeKnora-redis에서 사용할 DB 번호(1~15, WeKnora의 0과 겹치지 않도록 설정).
# LANGFUSE_REDIS_DB=1
# ClickHouse / Langfuse 전용 MinIO 자격 증명(운영 환경에서는 반드시 변경).
# LANGFUSE_CLICKHOUSE_USER=clickhouse
# LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
# LANGFUSE_MINIO_USER=langfuseminio
# LANGFUSE_MINIO_PASSWORD=langfuseminiosecret
# Langfuse 핵심 보안 필드. 운영 환경에서는 반드시 다시 생성하세요.
#   LANGFUSE_SALT=$(openssl rand -base64 32)
#   LANGFUSE_ENCRYPTION_KEY=$(openssl rand -hex 32)
#   LANGFUSE_NEXTAUTH_SECRET=$(openssl rand -base64 32)
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_NEXTAUTH_URL=http://localhost:3000
# LANGFUSE_TELEMETRY_ENABLED=false
# 선택 사항: 최초 시작 자동화(입력하면 관리자+프로젝트를 직접 주입하여 UI 회원가입 생략).
# LANGFUSE_INIT_ORG_ID=WeKnora
# LANGFUSE_INIT_ORG_NAME=WeKnora
# LANGFUSE_INIT_PROJECT_ID=WeKnora
# LANGFUSE_INIT_PROJECT_NAME=WeKnora
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-weknora-init
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-weknora-init
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_NAME=Admin
# LANGFUSE_INIT_USER_PASSWORD=change-me-please


# #####################################################################
# J. 보안 및 배포 튜닝
# #####################################################################

# ========== J1. SSRF 방어 ==========
# SSRF 검증 허용 목록(선택 사항). 쉼표로 구분하며, 각 항목은 정확한 도메인(api.internal), 와일드카드 도메인(*.example.com),
# IPv4(203.0.113.5), IPv6(2001:db8::1, 대괄호 제외) 또는 CIDR(10.0.0.0/8, 2001:db8::/32)일 수 있습니다.
# 목록에 포함된 대상은 URL 검증 등에서 일반 SSRF 규칙을 우회하므로 운영 환경에서는 신중하게 설정하세요.
# SSRF_WHITELIST=internal.service,*.corp.example,172.16.0.0/12,2001:db8::1,fd00::/8
#
# 허용 목록의 아웃바운드 연결만 허용합니다(기본 비활성화). true로 설정하면 허용 목록이 전체 아웃바운드 정책이 됩니다. SSRF_WHITELIST /
# SSRF_WHITELIST_EXTRA에 없는 호스트(IP 직접 연결 포함)는 DNS 조회 전에 즉시 거부합니다. 도메인은 이름만 대조하며,
# DNS 해석 결과로 CIDR과 대조하지 않습니다. 오프라인 또는 내부망 배포에서는 활성화하고 모델, 벡터 데이터베이스, 객체 저장소 등의 주소를 모두 허용 목록에 추가하는 것을 권장합니다.
# SSRF_DNS_WHITELIST_ONLY=false
#
# 아웃바운드 연결 수립 타임아웃(Go duration, 기본값 5s): 모델, 커넥터 등의 외부 엔드포인트에 이 시간 내 연결하지 못하면 실패합니다.
# 콜드 스타트가 느린 serverless 엔드포인트는 15s 등으로 늘릴 수 있습니다.
# WEKNORA_OUTBOUND_DIAL_TIMEOUT=5s
#
# ===== 벡터 데이터베이스 주소의 SSRF 검증 =====
# API로 벡터 데이터베이스 연결을 생성/테스트할 때 주소에 SSRF 검증을 적용합니다. docker-compose 내장 서비스
# (qdrant, milvus, weaviate, doris-fe, doris-be, searxng, minio)는 SSRF_WHITELIST_EXTRA를 통해 기본적으로 허용됩니다.
# 외부 사설망 주소 또는 차단된 포트(5432, 9200 등)를 사용한다면 호스트를 SSRF_WHITELIST_EXTRA에 추가하세요.
# (주의: 이 변수를 사용자 지정하면 compose 기본값을 덮어쓰므로 내장 서비스 이름을 다시 포함해야 합니다.) 예:
#   SSRF_WHITELIST_EXTRA=searxng,qdrant,milvus,weaviate,doris-fe,doris-be,minio,my-opensearch.internal
#
# Doris Stream Load: FE가 요청을 307로 BE에 리디렉션합니다. docker compose는 기본적으로
# doris-fe와 doris-be를 허용합니다(SSRF_WHITELIST_EXTRA 참조).
#
# 로컬 개발(go run + docker-compose.dev.yml --profile opensearch): 백엔드가 호스트에서 실행되며,
# OpenSearch에는 published 포트 http://localhost:9200으로 접근합니다. API로 이 벡터 데이터베이스를 생성하기 전에
# localhost를 SSRF_WHITELIST에 추가해야 합니다(9200은 차단된 포트이며 localhost는 제한된 호스트 이름).
#   SSRF_WHITELIST=localhost
# 원본 URL을 유지할 이미지 도메인 허용 목록(선택 사항, 쉼표로 구분). 설정하면 해당 도메인의 이미지도 다운로드하여 분석하지만
# (OCR/캡션), markdown에서는 객체 저장소의 provider:// URL로 바꾸지 않고 원본 URL을 유지합니다.
# IMAGE_HOST_KEEP_URL=mineru.internal.example.com

# ========== J2. 프록시 및 동시성 ==========
# gin이 신뢰하는 프록시 CIDR(쉼표로 구분). 기본적으로 loopback + 사설망 대역을 신뢰합니다(컨테이너 네트워크의 nginx 포함).
# 빈 문자열로 명시적으로 설정하면 프록시 신뢰가 비활성화됩니다(ClientIP는 직접 연결된 상대 주소 반환). 운영 환경에서 다중 프록시 뒤에 배포하는 경우 실제 구성에 맞게 입력하세요.
# WEKNORA_TRUSTED_PROXIES=
# ants 고루틴 풀 크기(Embedding 동시성, 429 발생 시 낮추세요).
CONCURRENCY_POOL_SIZE=5

# ========== J3. BrowserSkill 로컬 브라우저(선택 사항) ==========
# 사용자는 Chrome 확장 프로그램으로 연결합니다. 배포 및 제한 사항은 website-docs/05-clients/09-local-browser.md를 참조하세요.
# Docker app 이미지에는 bsk와 해당 확장 프로그램이 내장되어 있으며, 기본적으로 사용자의 현재 페이지에서 연결 주소를 자동 생성하므로 PUBLIC_URL 설정이 필요하지 않습니다.
# 네이티브 배포에서는 빌드 산출물을 준비하고 아래 두 파일 경로도 설정해야 합니다. BROWSERSKILL_BINARY=를 명시적으로 설정하면 이 기능을 끌 수 있습니다.
# 백엔드 시스템/아키텍처에 맞는 공식 bsk 실행 파일의 절대 경로(Docker에는 사전 설정되어 있으므로 추가 설정 불필요).
# BROWSERSKILL_BINARY=/opt/weknora/browserskill/bsk
# 선택적 재정의: 게이트웨이에 별도 도메인/경로를 사용하는 등 특수한 배포에서만 설정하세요. 원격 배포에서는 반드시 WSS를 사용해야 합니다(내부망 포함).
# BROWSERSKILL_PUBLIC_URL=wss://weknora.example.com/api/v1/local-browser/extension
# 애플리케이션 인스턴스 하나가 daemon 하나를 공유합니다. 보관할 최대 사용자 페어링 기록 수(기본값 32, 실측 수용량 아님).
# BROWSERSKILL_MAX_CONNECTIONS=32
# 개인 설정에서 다운로드할 확장 프로그램 ZIP(서버의 로컬 절대 경로, Docker에는 사전 설정됨).
# BROWSERSKILL_EXTENSION_PATH=/opt/weknora/browserskill/browser-skill-weknora-0.3.1.zip
# 다중 복제본: 각 노드에 다른 노드가 직접 접근할 수 있는 주소를 입력하고, 로드 밸런서 주소는 사용하지 마세요.
# BROWSERSKILL_INTERNAL_URL=http://10.0.0.12:8080
# 모든 복제본은 같은 무작위 키(최소 32자)를 사용해야 합니다. Secret으로 주입하고 저장소에 커밋하지 마세요.
# BROWSERSKILL_CLUSTER_SECRET=
